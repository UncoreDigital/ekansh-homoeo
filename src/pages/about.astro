---
import BaseLayout from '../layouts/BaseLayout.astro';
import DoctorProfileCard from '../components/DoctorProfileCard.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const ethicsPoints = [
  {
    num: "01",
    title: "Patient-Centered Listening",
    desc: "45–60 minutes allocated for initial consultations. You are treated as an active partner in your health."
  },
  {
    num: "02",
    title: "Constitutional Totality",
    desc: "Remedies are selected by individual totality, never generic mass combinations."
  },
  {
    num: "03",
    title: "Honest Prognosis",
    desc: "Strictly compliant with Ayush ethics: zero miracle cure claims and complete honesty regarding timelines."
  },
  {
    num: "04",
    title: "Strict Confidentiality",
    desc: "Your medical history, emotional discussions, and consultation notes are protected under patient privacy standards."
  },
  {
    num: "05",
    title: "Non-Emergency Triage",
    desc: "Acute trauma, surgical urgencies, and critical emergencies are promptly directed to tertiary hospitals."
  },
  {
    num: "06",
    title: "Doctor Continuity",
    desc: "You consult the same qualified homeopathic physician at every follow-up visit."
  }
];

const aboutFAQs = [
  {
    question: "What are the doctor's qualifications?",
    answer: "The doctor holds a formal university Bachelor of Homoeopathic Medicine & Surgery (B.H.M.S.) degree and is registered with the State Homoeopathic Medical Council, operating an independent individual practice in Rajsamand."
  },
  {
    question: "Why is a solo practitioner beneficial for me?",
    answer: "A solo practice guarantees complete continuity. The same doctor who conducts your detailed initial case-taking evaluates your remedy response at every follow-up."
  },
  {
    question: "Can outstation patients consult online?",
    answer: "Yes. In accordance with Indian Telemedicine Practice Guidelines, the doctor conducts video consultations for patients across India, with medicines dispatched via secure courier."
  }
];
---

<BaseLayout 
  title="About the Doctor | Ekansh Homoeopathic Clinic, Rajsamand"
  description="Meet the homeopathic physician at Ekansh Homoeopathic Clinic in Rajsamand. Formal medical training, individual constitutional care, and ethical practice."
  activeNav="about"
>
  <!-- Page Header -->
  <section class="page-header-section">
    <div class="container text-center">
      <span class="text-eyebrow">Practitioner &amp; Ethics</span>
      <h1 class="page-title">About the Doctor &amp; Practice</h1>
      <p class="page-subtitle text-lead">
        Dedicated to classical, constitutional homeopathy: listening first, understanding the whole individual, and prescribing gentle, restorative medicine.
      </p>
    </div>
  </section>

  <!-- Doctor Profile Section -->
  <section class="section-padding">
    <div class="container">
      <DoctorProfileCard showBio={false} />
    </div>
  </section>

  <!-- Clinical Ethics Section -->
  <section class="section-padding-sm ethics-section" id="ethics">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2rem;">
        <span class="text-eyebrow">Medical Standards</span>
        <h2>Our Clinical Ethics Code</h2>
        <p class="text-muted" style="max-width: 540px; margin: 0 auto;">
          Operating under the ethical codes of the Board of Homoeopathy and Ministry of Ayush.
        </p>
      </div>

      <div class="ethics-grid">
        {ethicsPoints.map((item) => (
          <div class="ethics-card card-editorial">
            <span class="ethics-num">{item.num}</span>
            <h3 class="ethics-title">{item.title}</h3>
            <p class="ethics-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQs Section -->
  <section class="section-padding-sm faq-section">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2rem;">
        <span class="text-eyebrow">Patient Inquiries</span>
        <h2>Frequently Asked Questions</h2>
      </div>

      <FAQAccordion items={aboutFAQs} />

      <div class="faq-cta text-center" style="margin-top: 2.25rem;">
        <a href="/book-consultation" class="btn btn-primary btn-md">
          <span>Schedule an Appointment</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header-section {
    padding: clamp(2.5rem, 5vw, 4rem) 0 1.75rem;
    background: radial-gradient(circle at top center, rgba(163, 177, 138, 0.16), transparent 70%);
    border-bottom: 1px solid var(--color-beige);
  }

  .page-title {
    margin-top: 0.4rem;
    margin-bottom: 0.75rem;
    color: var(--color-forest);
  }

  .page-subtitle {
    max-width: 600px;
    margin: 0 auto;
  }

  /* Ethics Grid */
  .ethics-section {
    background-color: var(--color-white);
  }

  .ethics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 991px) {
    .ethics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 580px) {
    .ethics-grid {
      grid-template-columns: 1fr;
    }
  }

  .ethics-card {
    padding: 1.5rem;
    background-color: var(--color-ivory);
  }

  .ethics-num {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-gold);
    display: block;
    margin-bottom: 0.4rem;
  }

  .ethics-title {
    font-size: 1.1rem;
    color: var(--color-charcoal);
    margin-bottom: 0.35rem;
  }

  .ethics-desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-charcoal-muted);
    margin-bottom: 0;
  }
</style>
