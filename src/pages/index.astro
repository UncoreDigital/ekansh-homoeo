---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import DoctorProfileCard from '../components/DoctorProfileCard.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import FindHealthConditions from '../components/FindHealthConditions.astro';
import BeforeYourVisit from '../components/BeforeYourVisit.astro';

const treatedConditions = [
  {
    title: "Chronic Allergies & Asthma",
    desc: "Dust allergies, recurrent sneezing, allergic rhinitis, and bronchial sensitivity evaluated through individualized care.",
    image: "/images/asthma.png",
  },
  {
    title: "Skin & Dermatological Care",
    desc: "Long-standing eczema, urticaria flare-ups, psoriasis discomfort, and acne evaluated through individualized care.",
    image: "/images/skin.png",
  },
  {
    title: "Digestive & Gut Health",
    desc: "Acidity, functional dyspepsia, chronic constipation, GERD, and stress-triggered irritable bowel patterns.",
    image: "/images/gut.png",
  },
  {
    title: "Pediatric & Child Wellness",
    desc: "Gentle micro-dilutions for childhood coughs, tonsillitis, recurrent colds, low immunity, and appetite development.",
    image: "/images/child.png",
  },
  {
    title: "Migraines & Stress Support",
    desc: "Recurrent vascular headaches, tension headaches, sleep disruption, and anxiety-related somatic complaints.",
    image: "/images/migraine.png",
  },
  {
    title: "Joint & Musculoskeletal Care",
    desc: "Arthritic stiffness, cervical spondylosis discomfort, lumbar strain, and joint inflammation management.",
    image: "/images/joints.png",
  }
];

const homeFAQs = [
  {
    question: "What makes constitutional homeopathic care different?",
    answer: "Constitutional care considers your complete physical, health, and lifestyle history. An individualized consultation allows the physician to recommend appropriate options tailored to your overall health."
  },
  {
    question: "How long does an initial consultation take?",
    answer: "Initial consultations typically take 45 to 60 minutes. The doctor conducts an unhurried, comprehensive case-taking to understand your health timeline, sensitivities, and constitutional picture."
  },
  {
    question: "Does submitting a consultation request mean my appointment is confirmed?",
    answer: "No. Submitting the online intake form is a consultation request, not an automatic confirmation. Our clinic desk will review practitioner availability and contact you directly via phone or WhatsApp to verify and confirm your slot."
  },
  {
    question: "Can I take homeopathic remedies alongside my existing allopathic medicines?",
    answer: "Yes. Homeopathy can safely be integrated alongside conventional medical treatments. We advise patients never to abruptly stop existing prescribed medications without consulting their physician."
  }
];
---

<BaseLayout 
  title="Ekansh Homoeopathic Clinic | Rajsamand, Rajasthan"
  description="Ekansh Homoeopathic Clinic in Rajsamand. Individualized constitutional care. In-clinic and online patient consultations. Care that begins with listening."
  activeNav="home"
>
  <!-- =========================================================================
       SECTION 1: HERO SECTION (Split Layout with Sanctuary Graphic)
       ========================================================================= -->
  <section class="hero-section">
    <div class="container hero-container">
      <!-- Left: Punchy Copy & Instant CTAs -->
      <div class="hero-content">
        <div class="hero-eyebrow-wrap">
          <span class="text-eyebrow">Rajsamand, Rajasthan</span>
          <span class="badge badge-sage">In-Clinic &bull; Online Tele-Consult</span>
        </div>

        <h1 class="hero-heading">
          A More Personal Approach to Your Healthcare Journey.
        </h1>

        <p class="hero-tagline">
          Care That Begins With Listening.
        </p>

        <p class="hero-lead text-lead">
          We spend 45 to 60 minutes with you—an individualised consultation that considers your complete health history, symptoms, and lifestyle rather than rushing through brief appointments.
        </p>

        <!-- High-Visibility Primary CTAs -->
        <div class="hero-cta-group">
          <a href="/book-consultation" class="btn btn-primary btn-lg hero-btn-main">
            <span>Book a Consultation</span>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="https://wa.me/919799988138?text=Hello%20Ekansh%20Clinic,%20I%20would%20like%20to%20enquire%20about%20an%20appointment." target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-lg">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            <span>WhatsApp Quick Desk</span>
          </a>
        </div>

        <!-- 3 Instant Trust Badges -->
        <div class="hero-trust-bar">
          <div class="trust-pill">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>45–60 Min Deep Intake</span>
          </div>
          <div class="trust-pill">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <span>Safe &amp; Non-Toxic</span>
          </div>
          <div class="trust-pill">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span>Same Doctor Every Visit</span>
          </div>
        </div>
      </div>

      <!-- Right: Graphic Illustration (Natural Sanctuary) -->
      <div class="hero-visual">
        <div class="hero-visual-card">
          <img 
            src="/images/hero-sanctuary.svg" 
            alt="Ekansh Homoeopathic Clinic Natural Sanctuary" 
            class="hero-illustration" 
            width="540" 
            height="450" 
            loading="eager"
          />
          <div class="floating-timing-card">
            <span class="timing-dot"></span>
            <div>
              <strong>Ekansh Clinic Open</strong>
              <small>Mon–Sat: 10AM–2PM &bull; 4PM–8PM | Sun: 10AM–2PM</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 2: CONDITIONS WE TREAT (High-Value Scannable Grid)
       ========================================================================= -->
  <section class="conditions-section section-padding-sm">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2rem;">
        <span class="text-eyebrow">Clinical Focus</span>
        <h2>Conditions Commonly Treated</h2>
        <p class="text-muted" style="max-width: 580px; margin: 0 auto;">
          Gentle, individualized constitutional care for chronic ailments and long-standing concerns.
        </p>
      </div>

      <div class="conditions-grid">
        {treatedConditions.map((item) => (
          <div class="condition-card card-editorial">
            <div class="cond-img-wrap">
              <img src={item.image} alt={item.title} class="cond-img" loading="lazy" width="380" height="200" />
            </div>
            <div class="cond-body">
              <h3 class="cond-title">{item.title}</h3>
              <p class="cond-desc">{item.desc}</p>
              <div class="cond-action-row" style="margin-top: 1rem;">
                <a 
                  href={`/book-consultation?condition=${encodeURIComponent(item.title)}`} 
                  class="btn btn-secondary btn-sm"
                  style="width: 100%; justify-content: center; font-size: 0.8125rem;"
                >
                  <span>Book Consultation</span>
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION: FIND HEALTH CONDITIONS (Mayo Clinic Inspired A–Z Directory & Search)
       ========================================================================= -->
  <FindHealthConditions id="find-conditions" />

  <!-- =========================================================================
       SECTION 3: ABOUT DOCTOR & CLINIC (Concise & Dignified)
       ========================================================================= -->
  <section class="doctor-section section-padding" id="doctor">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2.25rem;">
        <span class="text-eyebrow">Your Physician</span>
        <h2>A Clinic Built Around Personal Attention</h2>
        <p class="text-muted" style="max-width: 560px; margin: 0 auto;">
          Founded in Rajsamand to restore genuine listening and compassionate depth to medical consultations.
        </p>
      </div>

      <DoctorProfileCard showBio={false} />
    </div>
  </section>

  <!-- =========================================================================
       SECTION 4: YOUR JOURNEY TO PERSONALISED CARE (Merged Consultation Process & Principles)
       ========================================================================= -->
  <section class="care-journey-section section-padding" id="care-journey">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2.25rem;">
        <span class="text-eyebrow">Patient-First Healthcare</span>
        <h2>Your Journey to Personalised Care</h2>
        <p class="text-muted" style="max-width: 620px; margin: 0 auto;">
          From your initial request to your detailed consultation: thoughtful, unhurried, and designed entirely around you.
        </p>
      </div>

      <!-- 3-Step Horizontal Consultation Process -->
      <div class="journey-steps-grid">
        <!-- Step 1 -->
        <div class="journey-step-card card-editorial">
          <div class="step-card-top">
            <span class="step-badge">Step 01</span>
            <div class="step-icon-wrap">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </div>
          </div>
          <h3 class="step-title">Request a Consultation</h3>
          <p class="step-desc">
            Submit your preferred consultation details, modality (in-clinic in Rajsamand or online tele-consult), and time window through our secure intake form.
          </p>
          <span class="step-status-tag">Initial Request Submission</span>
        </div>

        <!-- Step 2 -->
        <div class="journey-step-card card-editorial">
          <div class="step-card-top">
            <span class="step-badge">Step 02</span>
            <div class="step-icon-wrap icon-forest">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
            </div>
          </div>
          <h3 class="step-title">Connect with the Clinic</h3>
          <p class="step-desc">
            Our clinic desk reviews your request against the practitioner schedule and communicates directly via phone or WhatsApp whether your preferred slot can be accepted.
          </p>
          <span class="step-status-tag">Desk Review &amp; Slot Verification</span>
        </div>

        <!-- Step 3 -->
        <div class="journey-step-card card-editorial">
          <div class="step-card-top">
            <span class="step-badge">Step 03</span>
            <div class="step-icon-wrap icon-gold">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
              </svg>
            </div>
          </div>
          <h3 class="step-title">Consult with the Doctor</h3>
          <p class="step-desc">
            Engage in an unhurried 45–60 minute constitutional case-taking session to explore your total health picture and receive customized homeopathic care.
          </p>
          <span class="step-status-tag">45–60 Min Deep Intake</span>
        </div>
      </div>

      <!-- Important Clarification Callout -->
      <div class="journey-clarification-banner">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" class="clarification-icon">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <p class="clarification-text">
          <strong>Important Appointment Clarification:</strong> Submitting a consultation form is an initial intake request, not an automatic appointment confirmation. All requests are subject to schedule availability and are confirmed directly by our clinic desk.
        </p>
      </div>

      <!-- Scannable Care Highlights Grid -->
      <div class="journey-principles-grid">
        <div class="principle-card card-editorial">
          <span class="principle-icon">🌿</span>
          <div class="principle-info">
            <h4 class="principle-title">Unhurried Listening</h4>
            <p class="principle-desc">45 to 60 minutes dedicated entirely to your complete health story. You are never rushed.</p>
          </div>
        </div>

        <div class="principle-card card-editorial">
          <span class="principle-icon">🔬</span>
          <div class="principle-info">
            <h4 class="principle-title">Constitutional Totality</h4>
            <p class="principle-desc">Remedies chosen strictly for your unique individual constitution, never generic mass combinations.</p>
          </div>
        </div>

        <div class="principle-card card-editorial">
          <span class="principle-icon">👨‍⚕️</span>
          <div class="principle-info">
            <h4 class="principle-title">Doctor Continuity</h4>
            <p class="principle-desc">Consistent personal care. You consult the same qualified homeopathic physician at every follow-up visit.</p>
          </div>
        </div>

        <div class="principle-card card-editorial">
          <span class="principle-icon">⚖️</span>
          <div class="principle-info">
            <h4 class="principle-title">Ethical &amp; Transparent</h4>
            <p class="principle-desc">Ethical medical practice: honest communication, realistic expectations, and transparent guidance.</p>
          </div>
        </div>
      </div>

      <div class="journey-cta-wrap text-center" style="margin-top: 2rem;">
        <a href="/book-consultation" class="btn btn-primary btn-md">
          <span>Request a Consultation</span>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
        <a href="/about" class="btn btn-secondary btn-md" style="margin-left: 0.75rem;">
          <span>Learn About the Clinic</span>
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 5: CONSULTATION SERVICES (In-Clinic vs Online)
       ========================================================================= -->
  <section class="services-section section-padding" id="services">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2.25rem;">
        <span class="text-eyebrow">Consultation Options</span>
        <h2>In-Clinic &amp; Online Services</h2>
        <p class="text-muted" style="max-width: 580px; margin: 0 auto;">
          Visit us in person in Rajsamand or schedule a video/audio tele-consultation from home.
        </p>
      </div>

      <div class="services-grid">
        <ServiceCard 
          title="In-Clinic Initial Consultation"
          badge="Ekansh Clinic"
          duration="45 – 60 Minutes"
          description="Unhurried, comprehensive face-to-face intake with on-site remedy dispensation in Rajsamand."
          image="/images/inClinic.png"
          imageAlt="Ekansh In-Clinic Consultation Room in Rajsamand"
          features={[
            "45–60 min unhurried physical & mental intake",
            "Individual constitutional repertorisation",
            "Prescribed remedies dispensed directly at clinic",
            "Clear dietary and lifestyle guidance"
          ]}
          isPopular={true}
          ctaText="Book Clinic Visit"
          ctaHref="/book-consultation?mode=in-clinic"
        />

        <ServiceCard 
          title="Online Tele-Consultation"
          badge="Nationwide Video / Call"
          duration="45 – 60 Minutes"
          description="In-depth video or audio appointment for patients across India and overseas."
          image="/images/online.png"
          imageAlt="Ekansh Online Tele-Consultation Desk"
          features={[
            "Full 45–60 min clinical depth via video call",
            "Ayush Telemedicine Guidelines compliant",
            "Remedies couriered safely to your doorstep",
            "WhatsApp prescription & tracking updates"
          ]}
          isPopular={false}
          ctaText="Book Online Consult"
          ctaHref="/book-consultation?mode=online"
        />

        <ServiceCard 
          title="Follow-Up Case Review"
          badge="In-Clinic or Online"
          duration="15 – 20 Minutes"
          description="Progress assessment scheduled 3 to 4 weeks after initial prescription."
          image="/images/followup.png"
          imageAlt="Doctor Follow-up Case Register"
          features={[
            "Systematic review of symptom trajectory",
            "Fine-tuning of remedy potencies or repetition",
            "Lifestyle and seasonal health adjustments",
            "Refill remedy dispensation or courier dispatch"
          ]}
          isPopular={false}
          ctaText="Schedule Follow-up"
          ctaHref="/book-consultation"
        />

        <ServiceCard 
          title="Acute Illness & Guidance"
          badge="Established Patients"
          duration="20 – 30 Minutes"
          description="Targeted consultation for sudden seasonal flu, viral coughs, or allergies."
          image="/images/acute.png"
          imageAlt="Homeopathic Acute Care Medicine"
          features={[
            "Targeted analysis of acute symptom triggers",
            "Individualized remedies tailored to acute symptom presentation",
            "Hydration and dietary management advice",
            "Seamless integration with ongoing care"
          ]}
          isPopular={false}
          ctaText="Request Acute Care"
          ctaHref="/book-consultation"
        />
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION: BEFORE YOUR VISIT (Practical Patient Preparation)
       ========================================================================= -->
  <BeforeYourVisit id="before-visit" />

  {/* =========================================================================
       SECTION 7: PATIENT REFLECTIONS (Testimonials Carousel) - TEMPORARILY COMMENTED OUT
       Preserved for future restoration; completely hidden from rendered page output.
       =========================================================================
  <section class="testimonials-section section-padding-sm" id="testimonials">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2.25rem;">
        <span class="text-eyebrow">Patient Feedback</span>
        <h2>Reflections on Our Care</h2>
        <p class="text-muted" style="max-width: 580px; margin: 0 auto;">
          Genuine reflections shared by patients who have received unhurried constitutional care at our clinic.
        </p>
      </div>

      <TestimonialCarousel />
    </div>
  </section>
  */}

  <!-- =========================================================================
       SECTION: COMPACT FREQUENTLY ASKED QUESTIONS
       ========================================================================= -->
  <section class="section-padding-sm home-faq-section" style="background-color: var(--color-white);">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2rem;">
        <span class="text-eyebrow">Common Queries</span>
        <h2>Frequently Asked Questions</h2>
        <p class="text-muted" style="max-width: 560px; margin: 0 auto;">
          Quick answers to common questions about our homeopathic practice, consultation process, and appointments.
        </p>
      </div>

      <FAQAccordion items={homeFAQs} />

      <div class="text-center" style="margin-top: 2rem;">
        <a href="/faqs" class="btn btn-secondary btn-md">
          <span>Have more questions? View All FAQs</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 8: FOREST-GREEN CTA (High-Converting Consultation Trigger)
       ========================================================================= -->
  <section class="forest-cta-section" id="cta-banner">
    <div class="container cta-container text-center">
      <span class="cta-eyebrow">Take the First Step</span>
      <h2 class="cta-heading">We're Here to Listen.</h2>
      <p class="cta-desc text-lead">
        Ready for unhurried, personalized healthcare? Book your in-clinic consultation in Rajsamand or schedule a video consultation from anywhere.
      </p>

      <div class="cta-buttons">
        <a href="/book-consultation" class="btn btn-gold btn-lg">
          <span>Book Your Consultation</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
        <a href="https://wa.me/919799988138?text=Hello%20Ekansh%20Clinic,%20I%20would%20like%20to%20enquire%20about%20a%20consultation." target="_blank" rel="noopener noreferrer" class="btn btn-outline-white btn-lg">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          <span>Chat on WhatsApp</span>
        </a>
      </div>

      <div class="cta-reassurance">
        <span>&bull; Confidential Intake</span>
        <span>&bull; Prior Appointment Recommended</span>
        <span>&bull; Serving Rajsamand &amp; Nationwide</span>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 9: CLINIC LOCATION & MAP (Crisp Vector Map Visual)
       ========================================================================= -->
  <section class="contact-preview-section section-padding-sm" id="location">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2rem;">
        <span class="text-eyebrow">Visit Us</span>
        <h2>Clinic Location &amp; Timings</h2>
      </div>

      <div class="contact-preview-grid">
        <!-- Details Card -->
        <div class="contact-info-card card-editorial">
          <div class="clinic-address-block">
            <div class="icon-circle">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div>
              <h3 class="location-name">Ekansh Homoeopathic Clinic</h3>
              <p class="location-address">
                Near Vijay Travels, Vivekanand Choraya,<br>
                Bhilwara Road, Kankroli, Rajsamand – 313324, Rajasthan, India<br/>
                <small class="text-muted">(Conveniently accessible from NH 58, Kankroli &amp; Nathdwara)</small>
              </p>
            </div>
          </div>

          <div class="hours-schedule-block">
            <h4 class="schedule-title">Daily Consultation Schedule</h4>
            <div class="schedule-table">
              <div class="sched-row">
                <span class="day">Mon – Sat Morning</span>
                <span class="time">10:00 AM – 2:00 PM</span>
              </div>
              <div class="sched-row">
                <span class="day">Mon – Sat Evening</span>
                <span class="time">4:00 PM – 8:00 PM</span>
              </div>
              <div class="sched-row">
                <span class="day">Sunday</span>
                <span class="time">10:00 AM – 2:00 PM</span>
              </div>
            </div>
          </div>

          <div class="direct-contact-actions">
            <a href="tel:+919799988138" class="btn btn-secondary btn-sm">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
