---
import BaseLayout from '../layouts/BaseLayout.astro';
import DoctorProfileCard from '../components/DoctorProfileCard.astro';
import ApproachPillars from '../components/ApproachPillars.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const aboutFAQs = [
  {
    question: "What qualifications do the physicians hold?",
    answer: "Both Dr. Akshat Chaplot and Dr. Neha Sukhwal hold Bachelor of Homoeopathic Medicine & Surgery (B.H.M.S.) degrees from recognized medical universities and are registered with the State Homoeopathic Council with credentials verified on file."
  },
  {
    question: "Why does an initial consultation take 45 to 60 minutes?",
    answer: "Classical constitutional homeopathy examines the entire person—including physical symptoms, sleep patterns, emotional stressors, past illnesses, and thermal reactions. This depth ensures the physician identifies the single remedy that matches your totality."
  },
  {
    question: "Will I consult the same doctor for my follow-up sessions?",
    answer: "Yes. We maintain strict doctor continuity. You consult the same qualified physician at every visit to ensure seamless case tracking and deeply informed care."
  },
  {
    question: "Where is the clinic located and can I visit in person?",
    answer: "The clinic is centrally located at Near Vijay Travels, Vivekanand Choraya, Bhilwara Road, Kankroli, Rajsamand – 313324, Rajasthan. We welcome in-person patients and offer prior appointments for convenience."
  }
];

const clinicHighlights = [
  {
    icon: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>`,
    title: "45–60 Min Deep Intake",
    desc: "We spend adequate time to understand your complete health history, lifestyle factors, and unique symptom timeline."
  },
  {
    icon: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`,
    title: "Constitutional Totality",
    desc: "Remedies are individually matched to your whole bodily constitution, avoiding generic mass combinations."
  },
  {
    icon: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>`,
    title: "Doctor Continuity",
    desc: "You consult the same qualified physician at every visit, ensuring consistent case tracking and personal care."
  },
  {
    icon: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`,
    title: "Ethical & Transparent",
    desc: "Strictly compliant with Ayush medical guidelines: zero exaggerated claims, honest prognosis, and genuine patient guidance."
  }
];

const caseTakingStages = [
  {
    stage: "Stage 1 (0–15 Min)",
    title: "Chief Complaint Analysis",
    desc: "Detailed exploration of primary illness, onset, sensations (burning, throbbing, aching), and specific modalities (heat/cold/time)."
  },
  {
    stage: "Stage 2 (15–30 Min)",
    title: "Physical Generals & Thermal Type",
    desc: "Evaluation of appetite, thirst, food aversions, thermal comfort (chilly vs warm), sleep patterns, and seasonal weather reactions."
  },
  {
    stage: "Stage 3 (30–45 Min)",
    title: "Emotional & Mental Disposition",
    desc: "Confidential review of mental stress, life transitions, temperamental traits, and personal stress responses."
  },
  {
    stage: "Stage 4 (45–60 Min)",
    title: "Repertorisation & Remedy Match",
    desc: "Synthesizing your complete symptom totality to select the single, highest-similarity constitutional remedy in minimum dose."
  }
];

const ethicsPoints = [
  {
    num: "01",
    title: "Patient-Centered Listening",
    desc: "45–60 minutes allocated for initial consultations. You are treated as an active partner in your health."
  },
  {
    num: "02",
    title: "Constitutional Totality",
    desc: "Remedies are selected by individual totality, never generic mass combinations."
  },
  {
    num: "03",
    title: "Honest Prognosis",
    desc: "Strictly compliant with medical ethics: transparent communication and realistic expectations regarding timelines."
  },
  {
    num: "04",
    title: "Strict Confidentiality",
    desc: "Your medical history, emotional discussions, and consultation notes are protected under patient privacy standards."
  },
  {
    num: "05",
    title: "Non-Emergency Triage",
    desc: "Acute trauma, surgical urgencies, and critical emergencies are promptly directed to tertiary hospitals."
  },
  {
    num: "06",
    title: "Doctor Continuity",
    desc: "You consult the same qualified homeopathic physician at every follow-up visit."
  }
];
---

<BaseLayout 
  title="About the Clinic | Ekansh Homoeopathic Clinic, Rajsamand"
  description="Learn about Ekansh Homoeopathic Clinic in Rajsamand: our classical constitutional care philosophy, medical ethics, practitioner details, and patient-first approach."
  activeNav="about"
>
  <!-- Page Header -->
  <section class="page-header-section">
    <div class="container text-center">
      <span class="text-eyebrow">Classical Constitutional Homeopathy &bull; Rajsamand</span>
      <h1 class="page-title">About the Clinic</h1>
      <p class="page-subtitle text-lead">
        Dedicated to thoughtful listening, constitutional care, and compassionate healing for patients in Rajsamand and across India.
      </p>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 1: INTRODUCTION TO EKANSH CLINIC
       ========================================================================= -->
  <section class="section-padding intro-section">
    <div class="container">
      <div class="intro-grid">
        <div class="intro-content">
          <span class="text-eyebrow">Our Story &amp; Purpose</span>
          <h2 class="intro-heading">A Calm Sanctuary for Thoughtful Healthcare</h2>
          <p class="intro-text">
            Ekansh Homoeopathic Clinic was established in Rajsamand, Rajasthan, with a simple yet essential mission: to restore genuine listening, depth, and individualized understanding to patient consultations.
          </p>
          <p class="intro-subtext text-muted">
            Instead of rushed 5-minute visits or generic prescriptions, we practice classical homeopathy that respects your body's natural restorative intelligence. We view each patient as a complete individual—integrating physical symptoms, mental stressors, lifestyle habits, and health history to discover the constitutional root cause.
          </p>

          <div class="intro-highlights-grid">
            {clinicHighlights.map((item) => (
              <div class="highlight-item">
                <div class="highlight-icon" set:html={item.icon} />
                <div>
                  <h4 class="highlight-title">{item.title}</h4>
                  <p class="highlight-desc">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="intro-visual-col">
          <div class="intro-image-frame card-editorial">
            <img 
              src="/images/hero-sanctuary.svg" 
              alt="Ekansh Homoeopathic Clinic Consultation Room in Rajsamand" 
              class="intro-clinic-img"
              width="540" 
              height="400" 
              loading="eager"
            />
            <div class="intro-image-caption">
              <strong>Ekansh Homoeopathic Clinic</strong>
              <span>Rajsamand, Rajasthan &bull; In-Clinic &amp; Online Tele-Consultations</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 2: MEET OUR PHYSICIANS
       ========================================================================= -->
  <section class="section-padding-sm doctor-section" id="doctor">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2rem;">
        <span class="text-eyebrow">Practitioners &amp; Credentials</span>
        <h2>Meet Our Physicians</h2>
        <p class="text-muted" style="max-width: 580px; margin: 0 auto;">
          Formal university medical training (B.H.M.S.), verified council registration, and compassionate constitutional practice in Rajsamand.
        </p>
      </div>

      <DoctorProfileCard showBio={false} />
    </div>
  </section>

  <!-- =========================================================================
       SECTION 3: OUR APPROACH TO CARE (Consolidated from Our Approach)
       ========================================================================= -->
  <section class="section-padding approach-section" id="approach">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2.25rem;">
        <span class="text-eyebrow">Care Philosophy</span>
        <h2>Our Approach to Care</h2>
        <p class="text-muted" style="max-width: 580px; margin: 0 auto;">
          Care that begins with listening: understanding your constitutional totality, respecting your body's vital intelligence, and avoiding symptom suppression.
        </p>
      </div>

      <!-- 4 Pillars Flow -->
      <ApproachPillars />

      <!-- 60-Minute Case Taking Breakdown -->
      <div class="case-taking-block" style="margin-top: 3.5rem;">
        <div class="section-header text-center" style="margin-bottom: 2rem;">
          <span class="text-eyebrow">Inside the Consultation</span>
          <h3>What Happens During Your 60-Minute Intake</h3>
          <p class="text-muted" style="max-width: 540px; margin: 0 auto;">
            A structured discovery session designed to map out your unique constitutional profile.
          </p>
        </div>

        <div class="stages-compact-grid">
          {caseTakingStages.map((item) => (
            <div class="stage-compact-card card-editorial">
              <span class="stage-badge">{item.stage}</span>
              <h4 class="stage-title">{item.title}</h4>
              <p class="stage-desc">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Clinical Ethics Code -->
      <div class="ethics-block" id="ethics" style="margin-top: 3.5rem;">
        <div class="section-header text-center" style="margin-bottom: 2rem;">
          <span class="text-eyebrow">Medical Standards</span>
          <h3>Our Clinical Ethics Code</h3>
          <p class="text-muted" style="max-width: 540px; margin: 0 auto;">
            Operating under the ethical codes of the Board of Homoeopathy and Ministry of Ayush.
          </p>
        </div>

        <div class="ethics-grid">
          {ethicsPoints.map((item) => (
            <div class="ethics-card card-editorial">
              <span class="ethics-num">{item.num}</span>
              <h4 class="ethics-title">{item.title}</h4>
              <p class="ethics-desc">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION: COMPACT FREQUENTLY ASKED QUESTIONS
       ========================================================================= -->
  <section class="section-padding-sm about-faq-section" style="background-color: var(--color-white);">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2rem;">
        <span class="text-eyebrow">Clinic &amp; Approach</span>
        <h2>Frequently Asked Questions</h2>
        <p class="text-muted" style="max-width: 560px; margin: 0 auto;">
          Key questions regarding our practice philosophy, doctor credentials, and consultation process.
        </p>
      </div>

      <FAQAccordion items={aboutFAQs} />

      <div class="text-center" style="margin-top: 2rem;">
        <a href="/faqs" class="btn btn-secondary btn-md">
          <span>Have more questions? View All FAQs</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 4: CALL TO ACTION
       ========================================================================= -->
  <section class="section-padding-sm cta-section">
    <div class="container">
      <div class="cta-banner card-editorial text-center">
        <span class="text-eyebrow text-gold">Begin Your Healing Journey</span>
        <h2 class="cta-heading">Ready for Thoughtful, Constitutional Care?</h2>
        <p class="cta-subtext">
          Whether you prefer an in-person consultation at our Rajsamand clinic or a video tele-consultation from home, our desk is here to assist you.
        </p>
        <div class="cta-btn-group">
          <a href="/book-consultation" class="btn btn-primary btn-lg">
            <span>Book Consultation</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
          <a href="/contact" class="btn btn-secondary btn-lg">
            <span>Contact Us</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header-section {
    padding: clamp(2.5rem, 5vw, 4rem) 0 2rem;
    background: radial-gradient(circle at top center, rgba(163, 177, 138, 0.16), transparent 70%);
    border-bottom: 1px solid var(--color-beige);
  }

  .page-title {
    margin-top: 0.4rem;
    margin-bottom: 0.75rem;
    color: var(--color-forest);
  }

  .page-subtitle {
    max-width: 600px;
    margin: 0 auto;
  }

  /* Intro Section Grid */
  .intro-section {
    background-color: var(--color-white);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3rem;
    align-items: center;
  }

  @media (max-width: 991px) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .intro-heading {
    margin: 0.35rem 0 1rem;
    color: var(--color-forest);
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
  }

  .intro-text {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-charcoal);
    margin-bottom: 0.75rem;
  }

  .intro-subtext {
    font-size: 0.90625rem;
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }

  .intro-highlights-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 580px) {
    .intro-highlights-grid {
      grid-template-columns: 1fr;
    }
  }

  .highlight-item {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }

  .highlight-icon {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm, 6px);
    background-color: #F0F4EE;
    color: var(--color-forest, #355D48);
    border: 1px solid #C8D6C0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .highlight-title {
    font-size: 0.90625rem;
    margin: 0 0 0.2rem;
    color: var(--color-charcoal, #303832);
    font-weight: 700;
  }

  .highlight-desc {
    font-size: 0.78125rem;
    line-height: 1.45;
    color: var(--color-charcoal-muted, #5A665D);
    margin: 0;
  }

  .intro-image-frame {
    overflow: hidden;
    padding: 0;
    border-radius: var(--radius-md, 8px);
    background: #FFFFFF;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  }

  .intro-clinic-img {
    width: 100%;
    aspect-ratio: 16 / 10;
    height: auto;
    max-height: 320px;
    object-fit: cover;
    display: block;
  }

  .intro-image-caption {
    padding: 1rem 1.25rem;
    background-color: var(--color-ivory, #F6F5EF);
    border-top: 1px solid var(--color-beige, #E9E4D7);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.8125rem;
  }

  .intro-image-caption strong {
    color: var(--color-forest, #355D48);
  }

  .intro-image-caption span {
    color: var(--color-charcoal-muted, #5A665D);
    font-size: 0.75rem;
  }

  /* Doctor Section */
  .doctor-section {
    background-color: var(--color-ivory, #F6F5EF);
  }

  /* Approach Section */
  .approach-section {
    background-color: var(--color-white);
  }

  /* 4 Stages Compact Grid */
  .stages-compact-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 991px) {
    .stages-compact-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 580px) {
    .stages-compact-grid {
      grid-template-columns: 1fr;
    }
  }

  .stage-compact-card {
    padding: 1.25rem;
    background-color: var(--color-ivory, #F6F5EF);
    border-radius: var(--radius-sm, 6px);
  }

  .stage-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-forest, #355D48);
    background-color: #E8F8F5;
    border: 1px solid #A3E4D7;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    margin-bottom: 0.65rem;
  }

  .stage-title {
    font-size: 0.96875rem;
    color: var(--color-charcoal, #303832);
    margin: 0 0 0.35rem;
    font-weight: 700;
  }

  .stage-desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-charcoal-muted, #5A665D);
    margin: 0;
  }

  /* Ethics Grid */
  .ethics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 991px) {
    .ethics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 580px) {
    .ethics-grid {
      grid-template-columns: 1fr;
    }
  }

  .ethics-card {
    padding: 1.5rem;
    background-color: var(--color-ivory, #F6F5EF);
    border-radius: var(--radius-sm, 6px);
  }

  .ethics-num {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-gold, #B9A77D);
    display: block;
    margin-bottom: 0.4rem;
  }

  .ethics-title {
    font-size: 1.05rem;
    color: var(--color-charcoal, #303832);
    margin: 0 0 0.35rem;
    font-weight: 700;
  }

  .ethics-desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-charcoal-muted, #5A665D);
    margin: 0;
  }

  /* CTA Section */
  .cta-section {
    background-color: var(--color-ivory, #F6F5EF);
  }

  .cta-banner {
    background: #FFFFFF;
    border: 1px solid var(--color-beige, #E9E4D7);
    border-radius: var(--radius-md, 8px);
    padding: clamp(2rem, 5vw, 3.5rem) 1.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    max-width: 820px;
    margin: 0 auto;
  }

  .cta-heading {
    color: var(--color-forest, #355D48);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin: 0.4rem 0 0.75rem;
  }

  .cta-subtext {
    color: var(--color-charcoal-muted, #5A665D);
    max-width: 560px;
    margin: 0 auto 1.75rem;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .cta-btn-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 580px) {
    .cta-btn-group {
      flex-direction: column;
      width: 100%;
    }

    .cta-btn-group .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
