---
interface Props {
  title?: string;
  showLogout?: boolean;
}

const {
  title = "Staff Portal | Ekansh Homoeopathic Clinic",
  showLogout = true,
} = Astro.props;

import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#355D48" />
  <meta name="robots" content="noindex, nofollow, noarchive" />
  
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  
  <title>{title}</title>
  
  <!-- Google Fonts: Playfair Display & DM Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet" />
</head>
<body class="admin-body">
  <!-- Minimalist Staff Top Header -->
  <header class="admin-topbar">
    <div class="admin-topbar-inner">
      <div class="admin-brand">
        <a href="/" class="admin-logo-link" title="Ekansh Home">
          <img src="/images/logo.png" alt="Ekansh Homoeopathic Clinic Logo" class="admin-logo-img" width="34" height="34" />
          <div>
            <span class="admin-brand-title">Ekansh Homoeopathic Clinic</span>
            <span class="admin-brand-badge">Office Desk Portal</span>
          </div>
        </a>
      </div>

      <div class="admin-topbar-actions">
        {showLogout && (
          <div class="admin-user-pill" id="adminUserPill" style="display: none;">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span id="adminUserEmail">staff</span>
          </div>
        )}
        
        {showLogout && (
          <button type="button" class="btn-admin-logout" id="adminLogoutBtn" style="display: none;" title="Sign out of staff portal">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Sign Out</span>
          </button>
        )}
      </div>
    </div>
  </header>

  <main class="admin-main">
    <slot />
  </main>

  <footer class="admin-footer">
    <div class="admin-footer-inner">
      <p>
        <strong>Ekansh Homoeopathic Clinic</strong> • Private Office Administration Portal<br>
        Rajsamand, Rajasthan, India • Protected by Supabase Row Level Security &amp; End-to-End Staff Verification
      </p>
    </div>
  </footer>

  <style>
    .admin-body {
      background-color: var(--color-ivory, #F6F5EF);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      color: var(--color-charcoal, #303832);
      font-family: var(--font-sans, 'DM Sans', sans-serif);
      margin: 0;
    }

    .admin-topbar {
      background-color: var(--color-forest, #355D48);
      color: #FFFFFF;
      padding: 0.85rem 1.5rem;
      border-bottom: 2px solid rgba(163, 177, 138, 0.4);
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    }

    .admin-topbar-inner {
      max-width: 1380px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .admin-brand a {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: #FFFFFF;
    }

    .admin-logo-img {
      object-fit: contain;
      background: #FFFFFF;
      border-radius: 6px;
      padding: 2px;
    }

    .admin-brand-title {
      font-family: var(--font-serif, 'Playfair Display', serif);
      font-size: 1.05rem;
      font-weight: 700;
      display: block;
      line-height: 1.2;
      letter-spacing: -0.01em;
    }

    .admin-brand-badge {
      display: inline-block;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-sage, #A3B18A);
      font-weight: 600;
    }

    .admin-topbar-actions {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .admin-user-pill {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      background: rgba(255, 255, 255, 0.12);
      padding: 0.35rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.8125rem;
      color: #FFFFFF;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .admin-user-pill svg {
      color: var(--color-sage, #A3B18A);
    }

    .btn-admin-logout {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(195, 81, 55, 0.18);
      border: 1px solid rgba(195, 81, 55, 0.5);
      color: #FFFFFF;
      padding: 0.4rem 0.85rem;
      border-radius: var(--radius-sm, 6px);
      font-size: 0.8125rem;
      font-weight: 600;
      cursor: pointer;
      transition: all var(--transition-fast, 150ms ease);
    }

    .btn-admin-logout:hover {
      background: #C35137;
      border-color: #C35137;
    }

    .admin-main {
      flex: 1;
      width: 100%;
      max-width: 1380px;
      margin: 0 auto;
      padding: clamp(1.5rem, 3vw, 2.5rem) 1.25rem;
    }

    .admin-footer {
      background: #FFFFFF;
      border-top: 1px solid var(--color-beige, #E9E4D7);
      padding: 1.5rem 1.25rem;
      text-align: center;
      font-size: 0.78125rem;
      color: var(--color-charcoal-muted, #5A665D);
      line-height: 1.6;
      margin-top: auto;
    }

    .admin-footer-inner {
      max-width: 800px;
      margin: 0 auto;
    }

    .admin-footer p {
      margin: 0;
    }

    @media (max-width: 640px) {
      .admin-topbar-inner {
        flex-direction: column;
        align-items: flex-start;
      }
      .admin-topbar-actions {
        width: 100%;
        justify-content: space-between;
      }
    }
  </style>

  <script>
    // Global admin logout handler
    const logoutBtn = document.getElementById('adminLogoutBtn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', async () => {
        try {
          await fetch('/api/admin/auth/logout', { method: 'POST' });
        } catch (e) {
          // ignore
        }
        sessionStorage.removeItem('admin_token');
        localStorage.removeItem('admin_token');
        window.location.href = '/admin/login';
      });
    }
  </script>
</body>
</html>
