---
import BaseLayout from '../layouts/BaseLayout.astro';
import ApproachPillars from '../components/ApproachPillars.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const caseTakingStages = [
  {
    stage: "Stage 1 (0–15 Min)",
    title: "Chief Complaint Analysis",
    desc: "Detailed exploration of primary illness, onset, sensations (burning, throbbing, aching), and specific modalities (heat/cold/time)."
  },
  {
    stage: "Stage 2 (15–30 Min)",
    title: "Physical Generals & Thermal Type",
    desc: "Evaluation of appetite, thirst, food aversions, thermal comfort (chilly vs warm), sleep patterns, and seasonal weather reactions."
  },
  {
    stage: "Stage 3 (30–45 Min)",
    title: "Emotional & Mental Disposition",
    desc: "Confidential review of mental stress, life transitions, temperamental traits, and personal stress responses."
  },
  {
    stage: "Stage 4 (45–60 Min)",
    title: "Repertorisation & Remedy Match",
    desc: "Synthesizing your complete symptom totality to select the single, highest-similarity constitutional remedy in minimum dose."
  }
];

const medicineCareRules = [
  {
    rule: "Take On a Clean Palate",
    desc: "Dissolve remedies 15 to 20 minutes before or after food, tea, coffee, or brushing teeth."
  },
  {
    rule: "Store Away From Strong Aromas",
    desc: "Keep bottles away from camphor, menthol, eucalyptus, perfumes, and pungent spices (hing/garlic)."
  },
  {
    rule: "Protect from Direct Sunlight",
    desc: "Store in a cool, dry, shaded drawer. Avoid leaving remedies inside hot parked vehicles or microwaves."
  },
  {
    rule: "Avoid Finger Handling",
    desc: "Pour sweet globules directly into the bottle cap and drop onto the tongue without touching."
  }
];

const approachFAQs = [
  {
    question: "Why does the initial consultation require 45 to 60 minutes?",
    answer: "Constitutional homeopathy treats the whole person, not just isolated symptoms. The doctor must evaluate physical characteristics, emotional disposition, and past health history to select your exact remedy."
  },
  {
    question: "Can I take homeopathic remedies with allopathic medicines?",
    answer: "Yes. In chronic conditions like thyroid, hypertension, or diabetes, constitutional remedies can be safely integrated alongside ongoing prescriptions without abruptly stopping existing medications."
  },
  {
    question: "Do homeopathic medicines cause side effects?",
    answer: "When prescribed by a qualified physician in appropriate minimum potencies, homeopathic remedies are gentle, non-toxic, and non-habit forming."
  }
];
---

<BaseLayout 
  title="Our Approach | Ekansh Homoeopathic Clinic, Rajsamand"
  description="The classical constitutional methodology at Ekansh Homoeopathic Clinic. Unhurried case-taking, root-cause healing, and patient-centered listening."
  activeNav="approach"
>
  <!-- Header -->
  <section class="page-header-section">
    <div class="container text-center">
      <span class="text-eyebrow">The Clinical Method</span>
      <h1 class="page-title">Our Clinical Approach</h1>
      <p class="page-subtitle text-lead">
        Care that begins with listening: understanding your constitutional totality, respecting your body's vital intelligence, and avoiding symptom suppression.
      </p>
    </div>
  </section>

  <!-- 4 Pillars Section -->
  <section class="section-padding">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2rem;">
        <span class="text-eyebrow">The Four Pillars</span>
        <h2>The Ekansh Care Journey</h2>
      </div>

      <ApproachPillars />
    </div>
  </section>

  <!-- 60-Minute Case Taking Breakdown -->
  <section class="section-padding-sm case-taking-section">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2rem;">
        <span class="text-eyebrow">Inside the Consultation</span>
        <h2>What Happens During Your 60-Minute Intake</h2>
        <p class="text-muted" style="max-width: 540px; margin: 0 auto;">
          A structured discovery session designed to map out your unique constitutional profile.
        </p>
      </div>

      <div class="stages-compact-grid">
        {caseTakingStages.map((item) => (
          <div class="stage-compact-card card-editorial">
            <span class="stage-badge">{item.stage}</span>
            <h3 class="stage-title">{item.title}</h3>
            <p class="stage-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Medicine Care & Storage Rules -->
  <section class="section-padding-sm storage-section">
    <div class="container">
      <div class="storage-card card-editorial card-beige">
        <div class="section-header text-center" style="margin-bottom: 1.75rem;">
          <span class="text-eyebrow">Patient Guidelines</span>
          <h2>Homeopathic Remedy Care &amp; Precautions</h2>
          <p class="text-muted" style="max-width: 520px; margin: 0 auto;">
            Simple guidelines to preserve remedy potency and ensure maximum therapeutic response.
          </p>
        </div>

        <div class="rules-compact-grid">
          {medicineCareRules.map((item, idx) => (
            <div class="rule-compact-box">
              <span class="rule-dot">{idx + 1}</span>
              <div>
                <h4 class="rule-name">{item.rule}</h4>
                <p class="rule-text">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="section-padding-sm faq-section">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2rem;">
        <span class="text-eyebrow">Methodology FAQs</span>
        <h2>Questions on Constitutional Care</h2>
      </div>

      <FAQAccordion items={approachFAQs} />

      <div class="faq-cta text-center" style="margin-top: 2.25rem;">
        <a href="/book-consultation" class="btn btn-primary btn-md">
          <span>Book Your Constitutional Session</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header-section {
    padding: clamp(2.5rem, 5vw, 4rem) 0 1.75rem;
    background: radial-gradient(circle at top center, rgba(163, 177, 138, 0.16), transparent 70%);
    border-bottom: 1px solid var(--color-beige);
  }

  .page-title {
    margin-top: 0.4rem;
    margin-bottom: 0.75rem;
    color: var(--color-forest);
  }

  .page-subtitle {
    max-width: 600px;
    margin: 0 auto;
  }

  /* Stages Grid */
  .case-taking-section {
    background-color: var(--color-white);
  }

  .stages-compact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 768px) {
    .stages-compact-grid {
      grid-template-columns: 1fr;
    }
  }

  .stage-compact-card {
    padding: 1.5rem;
    background-color: var(--color-ivory);
  }

  .stage-badge {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-forest);
    background-color: var(--color-sage-subtle);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .stage-title {
    font-size: 1.15rem;
    color: var(--color-charcoal);
    margin-bottom: 0.35rem;
  }

  .stage-desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-charcoal-muted);
    margin-bottom: 0;
  }

  /* Storage Card */
  .storage-card {
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .rules-compact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .rules-compact-grid {
      grid-template-columns: 1fr;
    }
  }

  .rule-compact-box {
    background-color: var(--color-white);
    border: 1px solid var(--color-beige-dark);
    border-radius: var(--radius-sm);
    padding: 1rem 1.25rem;
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .rule-dot {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: var(--color-forest);
    color: var(--color-white);
    font-weight: 700;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .rule-name {
    font-size: 0.90625rem;
    color: var(--color-charcoal);
    margin-bottom: 0.2rem;
    font-weight: 600;
  }

  .rule-text {
    font-size: 0.78125rem;
    line-height: 1.45;
    color: var(--color-charcoal-muted);
    margin-bottom: 0;
  }
</style>
