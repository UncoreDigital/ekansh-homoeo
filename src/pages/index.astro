---
import BaseLayout from '../layouts/BaseLayout.astro';
import ApproachPillars from '../components/ApproachPillars.astro';
import ServiceCard from '../components/ServiceCard.astro';
import DoctorProfileCard from '../components/DoctorProfileCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import FindHealthConditions from '../components/FindHealthConditions.astro';

const treatedConditions = [
  {
    title: "Chronic Allergies & Asthma",
    desc: "Dust allergies, recurrent sneezing, and bronchial sensitivity treated at the constitutional root.",
    image: "/images/asthma.png",
    icon: `<path d="M12 2a5 5 0 0 1 5 5c0 2.22-1.2 4.16-3 5.2V17h-4v-4.8C8.2 11.16 7 9.22 7 7a5 5 0 0 1 5-5z" stroke="currentColor" stroke-width="2"/><path d="M9 21h6" stroke="currentColor" stroke-width="2"/>`
  },
  {
    title: "Skin & Dermatological Care",
    desc: "Long-standing eczema, urticaria flare-ups, and recurring acne addressed without harsh suppressants.",
    image: "/images/skin.png",
    icon: `<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2"/>`
  },
  {
    title: "Digestive & Gut Health",
    desc: "Acidity, functional dyspepsia, chronic constipation, and stress-triggered irritable bowel patterns.",
    image: "/images/gut.png",
    icon: `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" stroke="currentColor" stroke-width="2"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" stroke="currentColor" stroke-width="2"/>`
  },
  {
    title: "Pediatric & Child Wellness",
    desc: "Gentle micro-dilutions for childhood coughs, tonsillitis, low immunity, and appetite development.",
    image: "/images/child.png",
    icon: `<circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="2"/><path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2" stroke="currentColor" stroke-width="2"/>`
  },
  {
    title: "Migraines & Stress Support",
    desc: "Recurrent vascular headaches, sleep disruption, and anxiety-related somatic complaints.",
    image: "/images/migraine.png",
    icon: `<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" stroke="currentColor" stroke-width="2"/><path d="M13.73 21a2 2 0 0 1-3.46 0" stroke="currentColor" stroke-width="2"/>`
  },
  {
    title: "Joint & Musculoskeletal Care",
    desc: "Arthritic stiffness, cervical spondylosis discomfort, and chronic lumbar strain management.",
    image: "/images/joints.png",
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2"/>`
  }
];
---

<BaseLayout 
  title="Ekansh Homoeopathic Clinic | Rajsamand, Rajasthan"
  description="Ekansh Homoeopathic Clinic in Rajsamand. Individualized constitutional care. In-clinic and online patient consultations. Care that begins with listening."
  activeNav="home"
>
  <!-- =========================================================================
       SECTION 1: HERO SECTION (Split Layout with Sanctuary Graphic)
       ========================================================================= -->
  <section class="hero-section">
    <div class="container hero-container">
      <!-- Left: Punchy Copy & Instant CTAs -->
      <div class="hero-content">
        <div class="hero-eyebrow-wrap">
          <span class="text-eyebrow">Rajsamand, Rajasthan</span>
          <span class="badge badge-sage">In-Clinic &bull; Online Tele-Consult</span>
        </div>

        <h1 class="hero-heading">
          A More Personal Approach to Your Healthcare Journey.
        </h1>

        <p class="hero-tagline">
          Care That Begins With Listening.
        </p>

        <p class="hero-lead text-lead">
          We spend 45 to 60 minutes with you to understand your complete health story—treating the root constitutional cause rather than rushing or masking symptoms.
        </p>

        <!-- High-Visibility Primary CTAs -->
        <div class="hero-cta-group">
          <a href="/book-consultation" class="btn btn-primary btn-lg hero-btn-main">
            <span>Book a Consultation</span>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="https://wa.me/919876543210?text=Hello%20Ekansh%20Clinic,%20I%20would%20like%20to%20enquire%20about%20an%20appointment." target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-lg">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            <span>WhatsApp Quick Desk</span>
          </a>
        </div>

        <!-- 3 Instant Trust Badges -->
        <div class="hero-trust-bar">
          <div class="trust-pill">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>45–60 Min Deep Intake</span>
          </div>
          <div class="trust-pill">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <span>Safe &amp; Non-Toxic</span>
          </div>
          <div class="trust-pill">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span>Same Doctor Every Visit</span>
          </div>
        </div>
      </div>

      <!-- Right: Graphic Illustration (Natural Sanctuary) -->
      <div class="hero-visual">
        <div class="hero-visual-card">
          <img 
            src="/images/hero-sanctuary.svg" 
            alt="Ekansh Homoeopathic Clinic Natural Sanctuary" 
            class="hero-illustration" 
            width="540" 
            height="450" 
            loading="eager"
          />
          <div class="floating-timing-card">
            <span class="timing-dot"></span>
            <div>
              <strong>Rajsamand Clinic Open</strong>
              <small>Mon–Sat: 10AM–1PM &bull; 5PM–8PM</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 2: CONDITIONS WE TREAT (High-Value Scannable Grid)
       ========================================================================= -->
  <section class="conditions-section section-padding-sm">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2rem;">
        <span class="text-eyebrow">Clinical Focus</span>
        <h2>Conditions Commonly Treated</h2>
        <p class="text-muted" style="max-width: 580px; margin: 0 auto;">
          Gentle, individualized constitutional care for chronic ailments and long-standing concerns.
        </p>
      </div>

      <div class="conditions-grid">
        {treatedConditions.map((item) => (
          <div class="condition-card card-editorial">
            <div class="cond-img-wrap">
              <img src={item.image} alt={item.title} class="cond-img" loading="lazy" width="380" height="200" />
              <div class="cond-icon-floating">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" set:html={item.icon}></svg>
              </div>
            </div>
            <div class="cond-body">
              <h3 class="cond-title">{item.title}</h3>
              <p class="cond-desc">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION: FIND HEALTH CONDITIONS (Mayo Clinic Inspired A–Z Directory & Search)
       ========================================================================= -->
  <FindHealthConditions id="find-conditions" />

  <!-- =========================================================================
       SECTION 3: ABOUT DOCTOR & CLINIC (Concise & Dignified)
       ========================================================================= -->
  <section class="doctor-section section-padding" id="doctor">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2.25rem;">
        <span class="text-eyebrow">Your Physician</span>
        <h2>A Clinic Built Around Personal Attention</h2>
        <p class="text-muted" style="max-width: 560px; margin: 0 auto;">
          Founded in Rajsamand to restore genuine listening and compassionate depth to medical consultations.
        </p>
      </div>

      <DoctorProfileCard showBio={false} />
    </div>
  </section>

  <!-- =========================================================================
       SECTION 4: OUR APPROACH (Visual 4-Pillar Flow)
       ========================================================================= -->
  <section class="approach-section section-padding" id="approach">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2.25rem;">
        <span class="text-eyebrow">The 4-Step Process</span>
        <h2>How Your Consultation Works</h2>
        <p class="text-muted" style="max-width: 580px; margin: 0 auto;">
          From your first conversation to long-term vitality: simple, structured, and collaborative.
        </p>
      </div>

      <ApproachPillars />

      <div class="approach-cta-wrap text-center" style="margin-top: 2rem;">
        <a href="/approach" class="btn btn-secondary btn-sm">
          <span>Read Full Case-Taking &amp; Medicine Storage Guide</span>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 5: CONSULTATION SERVICES (In-Clinic vs Online)
       ========================================================================= -->
  <section class="services-section section-padding" id="services">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2.25rem;">
        <span class="text-eyebrow">Consultation Options</span>
        <h2>In-Clinic &amp; Online Services</h2>
        <p class="text-muted" style="max-width: 580px; margin: 0 auto;">
          Visit us in person in Rajsamand or schedule a video/audio tele-consultation from home.
        </p>
      </div>

      <div class="services-grid">
        <ServiceCard 
          title="In-Clinic Initial Consultation"
          badge="Rajsamand Clinic"
          duration="45 – 60 Minutes"
          description="Unhurried, comprehensive face-to-face intake with on-site remedy dispensation in Rajsamand."
          image="/images/inClinic.png"
          imageAlt="Ekansh In-Clinic Consultation Room in Rajsamand"
          features={[
            "45–60 min unhurried physical & mental intake",
            "Individual constitutional repertorisation",
            "Certified quality remedies dispensed on-site",
            "Clear dietary and lifestyle guidance"
          ]}
          feePlaceholder="Verified on Request"
          isPopular={true}
          ctaText="Book Clinic Visit"
          ctaHref="/book-consultation?mode=in-clinic"
        />

        <ServiceCard 
          title="Online Tele-Consultation"
          badge="Nationwide Video / Call"
          duration="45 – 60 Minutes"
          description="In-depth video or audio appointment for patients across India and overseas."
          image="/images/online.png"
          imageAlt="Ekansh Online Tele-Consultation Desk"
          features={[
            "Full 45–60 min clinical depth via video call",
            "Ayush Telemedicine Guidelines compliant",
            "Remedies couriered safely to your doorstep",
            "WhatsApp prescription & tracking updates"
          ]}
          feePlaceholder="Verified on Request"
          isPopular={false}
          ctaText="Book Online Consult"
          ctaHref="/book-consultation?mode=online"
        />

        <ServiceCard 
          title="Follow-Up Case Review"
          badge="In-Clinic or Online"
          duration="15 – 20 Minutes"
          description="Progress assessment scheduled 3 to 4 weeks after initial prescription."
          image="/images/followup.png"
          imageAlt="Doctor Follow-up Case Register"
          features={[
            "Systematic review of symptom trajectory",
            "Fine-tuning of remedy potencies or repetition",
            "Lifestyle and seasonal health adjustments",
            "Quick refill dispensation or dispatch"
          ]}
          feePlaceholder="Verified on Request"
          isPopular={false}
          ctaText="Schedule Follow-up"
          ctaHref="/book-consultation"
        />

        <ServiceCard 
          title="Acute Illness & Guidance"
          badge="Established Patients"
          duration="20 – 30 Minutes"
          description="Targeted consultation for sudden seasonal flu, viral coughs, or allergies."
          image="/images/acute.png"
          imageAlt="Homeopathic Acute Care Medicine"
          features={[
            "Targeted analysis of acute symptom triggers",
            "Gentle remedies to support immune defense",
            "Hydration and dietary management advice",
            "Seamless integration with ongoing care"
          ]}
          feePlaceholder="Verified on Request"
          isPopular={false}
          ctaText="Request Acute Care"
          ctaHref="/book-consultation"
        />
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 6: WHY CHOOSE EKANSH (Concise Grid)
       ========================================================================= -->
  <section class="why-choose-section section-padding-sm" id="why-choose">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2rem;">
        <span class="text-eyebrow">The Difference</span>
        <h2>Why Patients Choose Ekansh</h2>
      </div>

      <div class="why-compact-grid">
        <div class="why-compact-card card-editorial">
          <span class="why-badge">01</span>
          <h4>Unhurried Listening</h4>
          <p>45 to 60 minutes dedicated entirely to your health story. You are never rushed.</p>
        </div>

        <div class="why-compact-card card-editorial">
          <span class="why-badge">02</span>
          <h4>Individualized Care</h4>
          <p>Remedies selected strictly for your unique constitutional totality, not generic formulas.</p>
        </div>

        <div class="why-compact-card card-editorial">
          <span class="why-badge">03</span>
          <h4>Honest &amp; Ethical</h4>
          <p>No miracle cure claims or false promises. We give transparent, realistic prognoses.</p>
        </div>

        <div class="why-compact-card card-editorial">
          <span class="why-badge">04</span>
          <h4>Same Doctor Always</h4>
          <p>Direct personal continuity. You always speak with your primary physician.</p>
        </div>

        <div class="why-compact-card card-editorial">
          <span class="why-badge">05</span>
          <h4>Gentle &amp; Non-Toxic</h4>
          <p>Micro-doses stimulate your body's vital defense without chemical dependency or side-effects.</p>
        </div>

        <div class="why-compact-card card-editorial">
          <span class="why-badge">06</span>
          <h4>Rajsamand &amp; Online</h4>
          <p>Easy physical clinic access for Mewar residents; door-to-door courier service nationwide.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 7: PATIENT REFLECTIONS (Short Testimonials)
       ========================================================================= -->
  <section class="testimonials-section section-padding-sm" id="testimonials">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2rem;">
        <span class="text-eyebrow">Patient Feedback</span>
        <h2>Reflections on Our Care</h2>
      </div>

      <div class="testimonials-grid">
        <TestimonialCard 
          quote="The doctor listened patiently for nearly an hour. Within three months of starting constitutional treatment, my seasonal allergies became completely manageable."
          patientName="Mr. R. Sharma"
          patientLocation="Rajsamand"
          conditionCategory="Chronic Allergies"
          consultationType="In-Clinic Patient"
        />

        <TestimonialCard 
          quote="The video consultation was just as thorough as being in a clinic. The doctor explained everything clearly, and the medicines reached my doorstep in Bengaluru in 3 days."
          patientName="Ms. S. Mehta"
          patientLocation="Bengaluru"
          conditionCategory="Stress & Gut Health"
          consultationType="Online Tele-Consult"
        />

        <TestimonialCard 
          quote="Very gentle approach with my 7-year-old child. Finding a doctor who takes time to understand recurrent coughs without rushing to strong antibiotics is wonderful."
          patientName="Mrs. P. Choudhary"
          patientLocation="Mewar Region"
          conditionCategory="Pediatric Care"
          consultationType="In-Clinic Patient"
        />
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 8: FOREST-GREEN CTA (High-Converting Consultation Trigger)
       ========================================================================= -->
  <section class="forest-cta-section" id="cta-banner">
    <div class="container cta-container text-center">
      <span class="cta-eyebrow">Take the First Step</span>
      <h2 class="cta-heading">We're Here to Listen.</h2>
      <p class="cta-desc text-lead">
        Ready for unhurried, personalized healthcare? Book your in-clinic consultation in Rajsamand or schedule a video consultation from anywhere.
      </p>

      <div class="cta-buttons">
        <a href="/book-consultation" class="btn btn-gold btn-lg">
          <span>Book Your Consultation</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
        <a href="https://wa.me/919876543210?text=Hello%20Ekansh%20Clinic,%20I%20would%20like%20to%20enquire%20about%20a%20consultation." target="_blank" rel="noopener noreferrer" class="btn btn-outline-white btn-lg">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          <span>Chat on WhatsApp</span>
        </a>
      </div>

      <div class="cta-reassurance">
        <span>&bull; Confidential Intake</span>
        <span>&bull; Prior Appointment Recommended</span>
        <span>&bull; Serving Rajsamand &amp; Nationwide</span>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 9: CLINIC LOCATION & MAP (Crisp Vector Map Visual)
       ========================================================================= -->
  <section class="contact-preview-section section-padding-sm" id="location">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2rem;">
        <span class="text-eyebrow">Visit Us</span>
        <h2>Clinic Location &amp; Timings</h2>
      </div>

      <div class="contact-preview-grid">
        <!-- Details Card -->
        <div class="contact-info-card card-editorial">
          <div class="clinic-address-block">
            <div class="icon-circle">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div>
              <h3 class="location-name">Ekansh Homoeopathic Clinic</h3>
              <p class="location-address">
                Near Landmark, Rajsamand, Rajasthan – 313324<br/>
                <small class="text-muted">(Conveniently accessible from NH 58 and Kankroli)</small>
              </p>
            </div>
          </div>

          <div class="hours-schedule-block">
            <h4 class="schedule-title">Daily Consultation Schedule</h4>
            <div class="schedule-table">
              <div class="sched-row">
                <span class="day">Mon – Sat Morning</span>
                <span class="time">10:00 AM – 1:00 PM</span>
              </div>
              <div class="sched-row">
                <span class="day">Mon – Sat Evening</span>
                <span class="time">5:00 PM – 8:00 PM</span>
              </div>
              <div class="sched-row">
                <span class="day">Sunday</span>
                <span class="time">Prior Appointment Only</span>
              </div>
            </div>
          </div>

          <div class="direct-contact-actions">
            <a href="tel:+919876543210" class="btn btn-secondary btn-sm">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>Call Clinic Desk</span>
            </a>
            <a href="/contact" class="btn btn-primary btn-sm">
              <span>View Full Contact Page</span>
            </a>
          </div>
        </div>

        <!-- Styled Vector Map Visual -->
        <div class="map-card card-editorial" style="padding: 0; overflow: hidden;">
          <div class="map-img-container">
            <img 
              src="/images/clinic-map.svg" 
              alt="Ekansh Homoeopathic Clinic Map Route Rajsamand" 
              class="clinic-map-img" 
              width="600" 
              height="380" 
              loading="lazy"
            />
            <div class="map-floating-pill">
              <span class="badge badge-sage">Rajsamand Anchor</span>
              <a href="https://maps.google.com/?q=Rajsamand+Rajasthan" target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-sm">
                Open in Google Maps
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero-section {
    padding-top: clamp(2rem, 4vw, 3.75rem);
    padding-bottom: clamp(2.5rem, 5vw, 4.25rem);
    background: radial-gradient(circle at top right, rgba(163, 177, 138, 0.16), transparent 60%);
    border-bottom: 1px solid var(--color-beige);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: center;
  }

  @media (max-width: 991px) {
    .hero-container {
      grid-template-columns: 1fr;
    }
  }

  .hero-eyebrow-wrap {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .hero-heading {
    margin-bottom: 0.4rem;
    color: var(--color-forest);
  }

  .hero-tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    color: var(--color-gold);
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .hero-lead {
    margin-bottom: 1.75rem;
    max-width: 540px;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .hero-btn-main {
    box-shadow: 0 6px 18px rgba(53, 93, 72, 0.3);
  }

  .hero-trust-bar {
    display: flex;
    align-items: center;
    gap: 1.125rem;
    flex-wrap: wrap;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-beige);
  }

  .trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78125rem;
    font-weight: 500;
    color: var(--color-charcoal-muted);
  }

  .trust-pill svg {
    color: var(--color-forest);
  }

  /* Hero Visual */
  .hero-visual-card {
    position: relative;
    border-radius: var(--radius-lg);
