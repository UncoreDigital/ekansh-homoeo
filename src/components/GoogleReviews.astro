---
/**
 * Ekansh Homoeopathic Clinic - Google Reviews Component
 * 
 * Fetches real patient reviews securely via server endpoint `/api/google-reviews`.
 * If API credentials are not configured or quota is exceeded, gracefully renders
 * an authentic Google Business Profile badge with a direct link to Google Maps.
 * Never creates fake reviews.
 */
---

<div class="google-reviews-wrapper" id="google-reviews-container">
  <!-- Rating Header Card -->
  <div class="reviews-header-card card-editorial">
    <div class="header-left">
      <div class="google-badge-brand">
        <!-- Google G Logo SVG -->
        <svg viewBox="0 0 24 24" width="28" height="28">
          <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
          <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.34 24 12 24z"/>
          <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.14-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
          <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.34 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
        </svg>
        <div>
          <h3 class="google-clinic-title">Google Business Profile</h3>
          <span class="verified-tag">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Verified Clinic Practice &bull; Rajsamand
          </span>
        </div>
      </div>
    </div>

    <div class="header-right">
      <div class="score-stars-box">
        <span class="score-number" id="gr-score">5.0</span>
        <div class="stars-row" aria-label="5 out of 5 stars">
          <span class="star-icon">★</span>
          <span class="star-icon">★</span>
          <span class="star-icon">★</span>
          <span class="star-icon">★</span>
          <span class="star-icon">★</span>
        </div>
        <span class="reviews-count-label" id="gr-count-label">Verified Patient Reviews</span>
      </div>
      <a 
        href="https://maps.google.com/?q=Ekansh+Homoeopathic+Clinic+Kankroli+Rajsamand" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn-secondary btn-sm"
        id="gr-maps-btn"
      >
        <span>View on Google Maps</span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
    </div>
  </div>

  <!-- Dynamic Reviews Container or Graceful Direct Card -->
  <div id="gr-cards-track" class="reviews-cards-grid">
    <!-- Default Graceful Fallback Card when live API is pending credentials -->
    <div class="review-placeholder-card card-editorial">
      <div class="placeholder-top">
        <div class="quote-mark">“</div>
        <p class="placeholder-text">
          Our practice is built upon attentive listening, unhurried constitutional case-taking, and patient-first care. We encourage all patients to read authentic experiences directly on our Google Business Profile or leave their own feedback following consultations.
        </p>
      </div>
      <div class="placeholder-footer">
        <div class="placeholder-badge">
          <strong>Ekansh Homoeopathic Clinic</strong>
          <span>Kankroli, Rajsamand &bull; Verified Google Reviews</span>
        </div>
        <a 
          href="https://maps.google.com/?q=Ekansh+Homoeopathic+Clinic+Kankroli+Rajsamand" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-primary btn-sm"
        >
          <span>Read Google Reviews</span>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- API Integration Hint (Clean, non-intrusive) -->
  <div class="api-status-notice" id="gr-status-notice" style="display: none;">
    <small>
      <strong>Google Places API:</strong> Real-time reviews are configured via <code>GOOGLE_PLACES_API_KEY</code> and <code>GOOGLE_PLACE_ID</code>.
    </small>
  </div>
</div>

<script>
  async function loadGoogleReviews() {
    try {
      const res = await fetch('/api/google-reviews');
      if (!res.ok) return;

      const data = await res.json();
      if (!data) return;

      const scoreEl = document.getElementById('gr-score');
      const countEl = document.getElementById('gr-count-label');
      const mapsBtn = document.getElementById('gr-maps-btn') as HTMLAnchorElement | null;
      const cardsTrack = document.getElementById('gr-cards-track');

      if (data.rating && scoreEl) {
        scoreEl.textContent = Number(data.rating).toFixed(1);
      }
      if (data.user_ratings_total && countEl) {
        countEl.textContent = `Based on ${data.user_ratings_total} Google Reviews`;
      }
      if (data.place_url && mapsBtn) {
        mapsBtn.href = data.place_url;
      }

      // If genuine reviews were returned from Google Places API
      if (data.configured && Array.isArray(data.reviews) && data.reviews.length > 0 && cardsTrack) {
        cardsTrack.innerHTML = '';
        data.reviews.slice(0, 3).forEach((rev: any) => {
          const card = document.createElement('div');
          card.className = 'review-card card-editorial';

          const stars = '★'.repeat(rev.rating || 5);

          card.innerHTML = `
            <div class="rev-card-top">
              <div class="rev-author-meta">
                <div class="rev-avatar">
                  ${rev.profile_photo_url 
                    ? `<img src="${rev.profile_photo_url}" alt="${rev.author_name}" loading="lazy" />` 
                    : `<span class="rev-avatar-initial">${(rev.author_name || 'P')[0]}</span>`
                  }
                </div>
                <div>
                  <h4 class="rev-author-name">${rev.author_name}</h4>
                  <span class="rev-time">${rev.relative_time || 'Google Review'}</span>
                </div>
              </div>
              <div class="rev-stars" aria-label="${rev.rating} out of 5 stars">${stars}</div>
            </div>
            <p class="rev-text">"${rev.text || 'Compassionate and thorough homeopathic consultation.'}"</p>
            <div class="rev-source-tag">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Verified Google Review</span>
            </div>
          `;
          cardsTrack.appendChild(card);
        });
      }
    } catch (e) {
      // Keep elegant fallback shell
    }
  }

  document.addEventListener('DOMContentLoaded', loadGoogleReviews);
</script>

<style>
  .google-reviews-wrapper {
    width: 100%;
    margin: 0 auto;
  }

  .reviews-header-card {
    background-color: var(--color-white);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border: 1px solid var(--color-beige);
    border-radius: var(--radius-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.03);
  }

  .google-badge-brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .google-clinic-title {
    margin: 0;
    font-size: 1.15rem;
    color: var(--color-forest);
  }

  .verified-tag {
    font-size: 0.75rem;
    color: var(--color-forest-dark);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 500;
    margin-top: 0.15rem;
  }

  .verified-tag svg {
    color: var(--color-sage-dark);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .score-stars-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .score-number {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-forest);
    font-family: var(--font-serif);
  }

  .stars-row {
    color: #F4B400; /* Google Star Yellow */
    font-size: 1.15rem;
    letter-spacing: 0.1rem;
    display: flex;
  }

  .reviews-count-label {
    font-size: 0.8125rem;
    color: var(--color-charcoal-muted);
    border-left: 1px solid var(--color-beige-dark);
    padding-left: 0.65rem;
    margin-left: 0.25rem;
  }

  /* Cards Grid */
  .reviews-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  /* Placeholder Card */
  .review-placeholder-card {
    grid-column: 1 / -1;
    background-color: var(--color-ivory);
    border: 1px solid var(--color-beige);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-md);
    position: relative;
  }

  .quote-mark {
    font-family: var(--font-serif);
    font-size: 3rem;
    line-height: 1;
    color: var(--color-gold);
    margin-bottom: -0.5rem;
  }

  .placeholder-text {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-charcoal);
    font-style: italic;
    max-width: 820px;
  }

  .placeholder-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-beige-dark);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .placeholder-badge {
    display: flex;
    flex-direction: column;
    font-size: 0.8125rem;
  }

  .placeholder-badge strong {
    color: var(--color-forest);
  }

  .placeholder-badge span {
    color: var(--color-charcoal-muted);
  }

  /* Real Review Cards */
  :global(.review-card) {
    background-color: var(--color-white);
    border: 1px solid var(--color-beige);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
  }

  :global(.rev-card-top) {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.85rem;
  }

  :global(.rev-author-meta) {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  :global(.rev-avatar) {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    overflow: hidden;
    background-color: var(--color-sage-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.rev-avatar img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.rev-avatar-initial) {
    font-weight: 700;
    color: var(--color-forest);
    font-size: 1rem;
  }

  :global(.rev-author-name) {
    font-size: 0.875rem;
    color: var(--color-forest);
    margin: 0;
    font-weight: 600;
  }

  :global(.rev-time) {
    font-size: 0.71875rem;
    color: var(--color-charcoal-muted);
  }

  :global(.rev-stars) {
    color: #F4B400;
    font-size: 0.875rem;
    letter-spacing: 0.05rem;
  }

  :global(.rev-text) {
    font-size: 0.84375rem;
    line-height: 1.55;
    color: var(--color-charcoal);
    font-style: italic;
    margin: 0 0 1rem 0;
    flex-grow: 1;
  }

  :global(.rev-source-tag) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.71875rem;
    color: var(--color-sage-dark);
    font-weight: 600;
    border-top: 1px solid var(--color-beige);
    padding-top: 0.5rem;
  }

  .api-status-notice {
    margin-top: 1rem;
    text-align: center;
    color: var(--color-charcoal-muted);
  }
</style>
