---
interface Props {
  showBio?: boolean;
}

const { showBio = true } = Astro.props;

const doctors = [
  {
    name: "Dr. Akshat Chaplot",
    degree: "B.H.M.S. • Homeopathic Physician",
    title: "Consultant Homeopathic Physician",
    image: "/images/doctor2.jpeg",
    imageAlt: "Dr. Akshat Chaplot - Consultant Homeopathic Physician, Ekansh Homoeopathic Clinic",
    quote: "Constitutional care begins with time and patience. We listen carefully to understand your complete health history, symptoms, and lifestyle.",
    style: "Classical Constitutional",
    focus: "Chronic Allergies, Skin & Dermatological Care, Digestive Health",
    highlights: [
      "45–60 minute deep constitutional case-taking",
      "Individualized single-remedy selection based on totality",
      "Consistent doctor continuity at every follow-up"
    ]
  },
  {
    name: "Dr. Neha Sukhwal",
    degree: "B.H.M.S. • Homeopathic Physician",
    title: "Consultant Homeopathic Physician",
    image: "/images/doctor.png",
    imageAlt: "Dr. Neha Sukhwal - Consultant Homeopathic Physician, Ekansh Homoeopathic Clinic",
    quote: "Every patient's health journey deserves empathy and individualized attention. We take the time to understand your unique concerns and health history.",
    style: "Classical Constitutional",
    focus: "Pediatric Wellness, Women's Health, Lifestyle & Stress Disorders",
    highlights: [
      "Compassionate, unhurried patient listening",
      "Individualized constitutional care & lifestyle support",
      "Holistic approach integrating diet & wellness"
    ]
  }
];
---

<div class="doctor-profile-wrapper">
  <!-- Concise Verification Notice -->
  <div class="verification-callout-compact">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="8" x2="12" y2="12"></line>
      <line x1="12" y1="16" x2="12.01" y2="16"></line>
    </svg>
    <span><strong>Practitioner Notice:</strong> Qualified homeopathic physicians (B.H.M.S.) practicing individualized constitutional homeopathy in Rajsamand, Rajasthan.</span>
  </div>

  <!-- Two-Doctor Side-by-Side Team Grid -->
  <div class="doctors-team-grid">
    {doctors.map((doc) => (
      <div class="doctor-card card-editorial">
        <div class="doctor-card-inner">
          <!-- Top: Physician Portrait & Quick Badge -->
          <div class="doctor-image-col">
            <div class="doctor-graphic-frame">
              <img 
                src={doc.image} 
                alt={doc.imageAlt} 
                class="doctor-graphic-img" 
                width="340" 
                height="400" 
                loading="lazy"
              />
            </div>

            <div class="doctor-quick-stats">
              <div class="quick-stat-item">
                <span class="stat-label">Practice Style:</span>
                <span class="stat-value">{doc.style}</span>
              </div>
              <div class="quick-stat-item">
                <span class="stat-label">Clinic Base:</span>
                <span class="stat-value">Rajsamand, Rajasthan</span>
              </div>
            </div>
          </div>

          <!-- Bottom / Details: Credentials & Practice Focus -->
          <div class="doctor-details-col">
            <div class="doctor-title-block">
              <span class="text-eyebrow">{doc.title}</span>
              <h3 class="doctor-name">{doc.name}</h3>
              <p class="doctor-degree">{doc.degree}</p>
            </div>

            <blockquote class="doctor-quote">
              "{doc.quote}"
            </blockquote>

            <!-- Highlights list -->
            <ul class="doctor-feature-list" role="list">
              {doc.highlights.map((hl) => (
                <li>
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>{hl}</span>
                </li>
              ))}
            </ul>

            <!-- Credentials Table -->
            <div class="credentials-summary">
              <div class="cred-row">
                <span class="cred-label">Qualification:</span>
                <span class="cred-val">Bachelor of Homoeopathic Medicine &amp; Surgery (B.H.M.S.)</span>
              </div>
              <div class="cred-row">
                <span class="cred-label">Modality:</span>
                <span class="cred-val">In-Clinic (Rajsamand) &amp; Online Consultations</span>
              </div>
              <div class="cred-row">
                <span class="cred-label">Focus Areas:</span>
                <span class="cred-val">{doc.focus}</span>
              </div>
            </div>

            <div class="doctor-actions">
  <a href="/book-consultation" class="btn btn-primary btn-sm">
    <span>Book Consultation</span>
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="12 5 19 12 12 19"></polyline>
    </svg>
  </a>
  <a
    href="https://wa.me/919799988138?text=Hello%20Ekansh%20Clinic,%20I%20would%20like%20to%20request%20a%20consultation%20with%20the%20doctor."
    target="_blank"
    rel="noopener noreferrer"
    class="btn btn-whatsapp btn-sm"
  >
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" />
      <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />
    </svg>
    <span>WhatsApp Desk</span>
  </a>
</div>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .doctor-profile-wrapper {
    width: 100%;
  }

  .verification-callout-compact {
    background-color: var(--color-amber-bg);
    border-left: 3px solid var(--color-gold);
    border-radius: var(--radius-xs);
    padding: 0.65rem 1rem;
    margin-bottom: 2rem;
    font-size: 0.8125rem;
    color: var(--color-charcoal);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .verification-callout-compact svg {
    color: var(--color-gold);
    flex-shrink: 0;
  }

  /* Two-Doctor Side-by-Side Grid */
  .doctors-team-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 3vw, 2.25rem);
    align-items: stretch;
  }

  @media (max-width: 960px) {
    .doctors-team-grid {
      grid-template-columns: 1fr;
    }
  }

  .doctor-card {
    background-color: var(--color-white);
    padding: clamp(1.5rem, 2.5vw, 2rem);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-beige);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
    height: 100%;
  }

  .doctor-card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* Doctor Photographic Frame */
  .doctor-image-col {
    margin-bottom: 1.25rem;
  }

  .doctor-graphic-frame {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 8px 24px -4px rgba(48, 56, 50, 0.12);
    border: 1px solid var(--color-beige-dark);
    background-color: var(--color-forest-dark);
    position: relative;
    max-height: 380px;
  }

  .doctor-graphic-img {
    width: 100%;
    height: 340px;
    display: block;
    object-fit: cover;
    object-position: top center;
    filter: contrast(103%) saturate(97%);
    transition: transform var(--transition-slow);
  }

  .doctor-graphic-frame:hover .doctor-graphic-img {
    transform: scale(1.02);
  }

  .doctor-quick-stats {
    margin-top: 0.75rem;
    padding: 0.65rem 0.9rem;
    background-color: var(--color-ivory);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-beige);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .quick-stat-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
  }

  .stat-label {
    color: var(--color-charcoal-muted);
  }

  .stat-value {
    font-weight: 600;
    color: var(--color-forest);
  }

  /* Details Column */
  .doctor-details-col {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .doctor-name {
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    color: var(--color-forest);
    margin-top: 0.2rem;
    margin-bottom: 0.15rem;
  }

  .doctor-degree {
    font-size: 0.8125rem;
    color: var(--color-charcoal-muted);
    font-weight: 500;
    margin-bottom: 0.85rem;
  }

  .doctor-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-forest-dark);
    padding: 0.65rem 0.85rem;
    border-left: 3px solid var(--color-accent-red);
    background-color: var(--color-ivory);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin: 0 0 1rem 0;
  }

  .doctor-feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .doctor-feature-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-charcoal);
  }

  .doctor-feature-list svg {
    color: var(--color-sage-dark);
    flex-shrink: 0;
  }

  /* Credentials Summary */
  .credentials-summary {
    border: 1px solid var(--color-beige);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.85rem;
    background-color: var(--color-ivory);
    margin-bottom: 1.25rem;
    font-size: 0.78125rem;
    margin-top: auto;
  }

  .cred-row {
    display: flex;
    padding: 0.3rem 0;
    border-bottom: 1px solid rgba(233, 228, 215, 0.7);
  }

  .cred-row:last-child {
    border-bottom: none;
  }

  .cred-label {
    width: 95px;
    font-weight: 600;
    color: var(--color-forest);
    flex-shrink: 0;
  }

  .cred-val {
    color: var(--color-charcoal);
  }

  .doctor-actions {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-top: auto;
  }

  .doctor-actions .btn {
    flex: 1;
    min-width: 140px;
    justify-content: center;
  }

/* Fix doctor image cropping on mobile */
@media (max-width: 767px) {
  .doctor-graphic-frame {
    height: auto;
    max-height: none;
    overflow: hidden;
  }

  .doctor-graphic-img {
    width: 100%;
    height: auto;
    max-height: none;
    aspect-ratio: 4 / 5;
    object-fit: contain;
    object-position: center;
  }
}

</style>
