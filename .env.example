# ==============================================================================
# Ekansh Homoeopathic Clinic - Environment Variables Template
# ==============================================================================
# IMPORTANT:
# 1. Duplicate this file as '.env' in your local project root:
#    cp .env.example .env
# 2. Fill in your real API keys locally.
# 3. NEVER commit your '.env' file to Git or expose keys to the public.
# 4. In Vercel, add these same variables under:
#    Project Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
# SUPABASE_URL: Your Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# SUPABASE_SECRET_KEY: Your Supabase secret/service_role key (starts with sb_secret_ or service_role)
# CRITICAL: Keep this strictly server-side. Never use in client-side code.
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# PUBLIC_SUPABASE_ANON_KEY: Supabase public publishable/anon key (starts with eyJ...)
# Safe for client-side authentication if needed.
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# ------------------------------------------------------------------------------
# Admin Staff Access Control (Allowlist)
# ------------------------------------------------------------------------------
# Comma-separated list of authorized staff email addresses that may log in to
# the private admin portal (/admin/dashboard).
# Authenticated Supabase users whose email is not on this list will be rejected with 403 Forbidden.
ADMIN_EMAILS=staff@ekanshclinic.com,doctor@ekanshclinic.com,roshni.uncore@gmail.com

# ------------------------------------------------------------------------------
# Resend Email Configuration
# ------------------------------------------------------------------------------
# Found in Resend Dashboard (https://resend.com) -> API Keys
RESEND_API_KEY=re_your_resend_api_key_here

# Development/Testing sender address (free Resend testing domain)
RESEND_FROM_EMAIL=Ekansh Clinic <onboarding@resend.dev>

# Notification recipient email address where clinic intake alerts will be sent
RESEND_TO_EMAIL=roshni.uncore@gmail.com



# ------------------------------------------------------------------------------
# SMTP Email Configuration (Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_smtp_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM_EMAIL=
CLINIC_NOTIFICATION_EMAIL=your_clinic_email@example.com
CLINIC_NOTIFICATION_CC_EMAIL=your_cc_email@example.com

# ------------------------------------------------------------------------------
# Google Places API (Optional - For Live Google Reviews & Ratings)
# ------------------------------------------------------------------------------
# Set these to stream authentic patient reviews directly into the website.
# If omitted or unconfigured, the website automatically falls back to an elegant
# verified Google Business Profile card with a direct Google Maps review link.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_PLACE_ID=your_google_place_id_here

