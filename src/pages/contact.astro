---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const contactFAQs = [
  {
    question: "Where is the clinic situated in Rajsamand?",
    answer: "Ekansh Homoeopathic Clinic is located Near Vijay Travels, Vivekanand Choraya, Bhilwara Road, Kankroli, Rajsamand – 313324, Rajasthan. It is easily accessible from NH 58, Kankroli bus stop, and Nathdwara."
  },
  {
    question: "What are the clinic consultation hours?",
    answer: "We are open Monday to Saturday with Morning Sessions from 10:00 AM to 2:00 PM and Evening Sessions from 4:00 PM to 8:00 PM. On Sundays, the clinic is open from 10:00 AM to 2:00 PM."
  },
  {
    question: "Can I walk in without a prior appointment?",
    answer: "While urgent walk-ins are accommodated subject to waiting times, we strongly recommend requesting an appointment in advance so our doctors can reserve adequate, unhurried time (45–60 minutes) for your intake."
  },
  {
    question: "How can I reach the reception desk directly?",
    answer: "You can call us directly at +91 97999 88138 or +91 95216 46525, or message our clinic WhatsApp desk at +91 97999 88138."
  }
];
---

<BaseLayout 
  title="Contact Us & Clinic Coordinates | Ekansh Homoeopathic Clinic"
  description="Connect with Ekansh Homoeopathic Clinic in Rajsamand. Clinic address, phone numbers, consultation hours, location map, and direct inquiry."
  activeNav="contact"
>
  <!-- Header -->
  <section class="page-header-section">
    <div class="container text-center">
      <span class="text-eyebrow">Connect With Us</span>
      <h1 class="page-title">Clinic Location &amp; Contact</h1>
      <p class="page-subtitle text-lead">
        We welcome your questions and consultation inquiries. Connect with our Rajsamand clinic desk via phone, WhatsApp, or our secure inquiry form.
      </p>
    </div>
  </section>

  <!-- Main Contact Section -->
  <section class="section-padding">
    <div class="container">
      <div class="contact-layout-grid">
        <!-- Left: Clinic Coordinates & Operating Hours -->
        <div class="contact-details-col">
          <div class="card-editorial card-beige" style="padding: clamp(1.75rem, 3.5vw, 2.5rem); height: 100%;">
            <!-- <span class="text-eyebrow">Rajsamand Practice</span> -->
            <h2 class="col-heading">Ekansh Homoeopathic Clinic</h2>
            
            <div class="contact-info-list">
              <!-- Address -->
              <div class="info-item">
                <div class="info-icon">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                </div>
                <div>
                  <h4 class="info-title">Physical Address</h4>
                  <p class="info-desc">
                    Near Vijay Travels, Vivekanand Choraya,<br>
                    Bhilwara Road, Kankroli, Rajsamand – 313324, Rajasthan, India<br/>
                    <small class="text-muted">(Conveniently accessible from NH 58, Kankroli &amp; Nathdwara)</small>
                  </p>
                </div>
              </div>

              <!-- Phone -->
              <div class="info-item">
                <div class="info-icon">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                </div>
                <div>
                  <h4 class="info-title">Telephone Inquiries</h4>
                  <p class="info-desc">
                    <a href="tel:+919799988138">+91 97999 88138</a> &bull; <a href="tel:+9195216 46525">+91 95216 46525</a>
                  </p>
                </div>
              </div>

              <!-- WhatsApp -->
              <div class="info-item">
                <div class="info-icon" style="background-color: var(--color-accent-red-light); color: var(--color-accent-red);">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                  </svg>
                </div>
                <div>
                  <h4 class="info-title">WhatsApp Booking Desk</h4>
                  <p class="info-desc">
                    <a href="https://wa.me/919799988138?text=Hello%20Ekansh%20Clinic,%20I%20would%20like%20to%20enquire%20about%20a%20consultation." target="_blank" rel="noopener noreferrer">
                      Direct WhatsApp Desk (+91 97999 88138)
                    </a>
                  </p>
                </div>
              </div>
            </div>

            <!-- Operating Hours Box -->
            <div class="operating-hours-container">
              <h4 class="hours-box-title">Consultation Schedule</h4>
              <div class="hours-row">
                <span>Mon – Sat Morning:</span>
                <strong>10:00 AM – 2:00 PM</strong>
              </div>
              <div class="hours-row">
                <span>Mon – Sat Evening:</span>
                <strong>4:00 PM – 8:00 PM</strong>
              </div>
              <div class="hours-row">
                <span>Sunday:</span>
                <strong>10:00 AM – 2:00 PM</strong>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Fast Inquiry Form -->
        <div class="contact-form-col">
          <div class="card-editorial" style="padding: clamp(1.75rem, 3.5vw, 2.5rem); background-color: var(--color-white);">
            <span class="text-eyebrow">Message Reception</span>
            <h2 class="col-heading">Send an Inquiry</h2>
            <p class="text-muted" style="font-size: 0.84375rem; margin-bottom: 1.25rem;">
              Have a question on treatment suitability or scheduling? Fill out your message below:
            </p>

            <form id="inquiryForm" novalidate>
              <!-- Anti-bot Honeypot Field (Hidden from real users) -->
              <div style="position: absolute; left: -9999px; top: -9999px; opacity: 0; pointer-events: none;" aria-hidden="true">
                <label for="contact_hp">Leave this field blank</label>
                <input type="text" id="contact_hp" name="website_hp" tabindex="-1" autocomplete="off" />
              </div>

              <div class="form-group">
                <label for="inqName" class="form-label">Full Name <span class="required">*</span></label>
                <input type="text" id="inqName" name="inqName" class="form-control" placeholder="Your name" required />
                <span class="form-error" id="inqNameError">Please enter your name.</span>
              </div>

              <div class="form-group">
                <label for="inqPhone" class="form-label">Phone Number <span class="required">*</span></label>
                <input type="tel" id="inqPhone" name="inqPhone" class="form-control" placeholder="10-digit mobile number" required />
                <span class="form-error" id="inqPhoneError">Please enter a valid 10-digit mobile number.</span>
              </div>

              <div class="form-group">
                <label for="inqInterest" class="form-label">Inquiry Nature</label>
                <select id="inqInterest" name="inqInterest" class="form-control">
                  <option value="In-Clinic Visit in Rajsamand">In-Clinic Visit in Rajsamand</option>
                  <option value="Online Video Consultation">Online Video Consultation</option>
                  <option value="Chronic Condition Guidance">Chronic Condition Guidance</option>
                  <option value="Pediatric Care Inquiry">Pediatric Care Inquiry</option>
                </select>
              </div>

              <div class="form-group">
                <label for="inqMessage" class="form-label">Your Message <span class="required">*</span></label>
                <textarea id="inqMessage" name="inqMessage" class="form-control" rows="3" placeholder="How may we assist you?" required></textarea>
                <span class="form-error" id="inqMsgError">Please write your inquiry message.</span>
              </div>

              <!-- Error Alert Box -->
              <div id="inquiryErrorAlert" class="inquiry-error-alert" style="display: none;" role="alert">
                <span id="inquiryErrorMessage"></span>
              </div>

              <button type="submit" class="btn btn-primary btn-lg" id="inqSubmitBtn" style="width: 100%;">
                <span id="inqSubmitText">Submit Inquiry</span>
                <svg id="inqSubmitIcon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>
            </form>

            <!-- Contact Enquiry Success Message -->
            <div class="inquiry-success-card" id="inquirySuccess" style="display: none;" role="status" aria-live="polite">
              <!-- ROW 1: Icon + Heading + Acknowledgement -->
              <div class="inquiry-success-header-row">
                <div class="inquiry-success-icon-wrap" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                  </svg>
                </div>
                <div class="inquiry-success-text-wrap">
                  <h3 class="inquiry-success-title">Enquiry Received!</h3>
                  <p class="inquiry-success-desc">
                    Thank you for contacting Ekansh Homoeopathic Clinic. Your message has been safely received by our clinic desk.
                  </p>
                </div>
              </div>

              <!-- ROW 2: Highlighted Clarification Notice Box -->
              <div class="inquiry-success-notice-box">
                <strong>Please Note:</strong> This is a general enquiry submission, not an appointment booking or confirmation.
              </div>

              <!-- ROW 3: WhatsApp Action Row -->
              <div class="inquiry-success-action-row">
                <a href="#" id="inqWhatsAppLink" target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-sm">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                  </svg>
                  Connect via WhatsApp
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vector Map Guide -->
  <section class="section-padding-sm map-section" id="clinic-map" style="background-color: var(--color-white);">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 1.75rem;">
        <span class="text-eyebrow">Directions</span>
        <h2>How to Reach Ekansh Clinic</h2>
      </div>

      <div class="map-card card-editorial" style="padding: 0; overflow: hidden; max-width: 900px; margin: 0 auto;">
        <div class="map-img-container">
          <img 
            src="/images/clinic-map.svg" 
            alt="Ekansh Homoeopathic Clinic Map Route Rajsamand" 
            class="clinic-map-img" 
            width="600" 
            height="380" 
            loading="lazy"
          />
          <div class="map-floating-pill">
            <span class="badge badge-sage">Ekansh Location</span>
            <a href="https://maps.google.com/?q=Ekansh+Homoeopathic+Clinic+Kankroli+Rajsamand" target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-sm">
              Open in Google Maps
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Compact FAQs Section -->
  <section class="section-padding-sm contact-faq-section" style="background-color: var(--color-beige-subtle, #FAF9F5);">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2rem;">
        <span class="text-eyebrow">Location &amp; Visiting</span>
        <h2>Frequently Asked Questions</h2>
        <p class="text-muted" style="max-width: 560px; margin: 0 auto;">
          Helpful information about clinic location, visiting guidelines, and contacting our reception desk.
        </p>
      </div>

      <FAQAccordion items={contactFAQs} />

      <div class="text-center" style="margin-top: 2rem;">
        <a href="/faqs" class="btn btn-secondary btn-md">
          <span>Have more questions? View All FAQs</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header-section {
    padding: clamp(2.5rem, 5vw, 4rem) 0 1.75rem;
    background: radial-gradient(circle at top center, rgba(163, 177, 138, 0.16), transparent 70%);
    border-bottom: 1px solid var(--color-beige);
  }

  .page-title {
    margin-top: 0.4rem;
    margin-bottom: 0.75rem;
    color: var(--color-forest);
  }

  .page-subtitle {
    max-width: 600px;
    margin: 0 auto;
  }

  .contact-layout-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  @media (max-width: 860px) {
    .contact-layout-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .contact-layout-grid {
      gap: 1.25rem;
    }

    .contact-details-col .card-editorial,
    .contact-form-col .card-editorial {
      padding: 1.25rem 1.15rem !important;
    }

    .map-floating-pill {
      bottom: 10px;
      left: 10px;
      right: 10px;
      padding: 0.6rem 0.75rem;
      flex-direction: column;
      gap: 0.5rem;
      align-items: stretch;
      text-align: center;
    }

    .map-floating-pill .btn {
      width: 100%;
      justify-content: center;
    }
  }

  .col-heading {
    font-size: 1.4rem;
    color: var(--color-forest);
    margin-top: 0.25rem;
    margin-bottom: 1.25rem;
  }

  .contact-info-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .info-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .info-icon {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background-color: var(--color-white);
    border: 1px solid var(--color-beige-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-forest);
    flex-shrink: 0;
  }

  .info-title {
    font-size: 0.875rem;
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-charcoal);
    margin-bottom: 0.15rem;
  }

  .info-desc {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-charcoal-muted);
    margin-bottom: 0;
  }

  .info-desc a {
    color: var(--color-forest);
    font-weight: 600;
  }

  .operating-hours-container {
    background-color: var(--color-white);
    border: 1px solid var(--color-beige-dark);
    border-radius: var(--radius-sm);
    padding: 1rem 1.25rem;
  }

  .hours-box-title {
    font-family: var(--font-sans);
    font-size: 0.84375rem;
    font-weight: 600;
    color: var(--color-forest);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .hours-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.78125rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--color-beige);
    color: var(--color-charcoal);
  }

  .hours-row:last-child {
    border-bottom: none;
  }

  .hours-row span {
    color: var(--color-charcoal-muted);
  }

  .hours-row strong {
    color: var(--color-forest);
  }

  /* Map Container */
  .map-img-container {
    position: relative;
    width: 100%;
    min-height: 320px;
  }

  .clinic-map-img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .map-floating-pill {
    position: absolute;
    bottom: 16px;
    left: 16px;
    right: 16px;
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-beige);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    box-shadow: var(--shadow-card);
  }

  /* Inquiry Error Alert Box */
  .inquiry-error-alert {
    width: 100%;
    padding: 0.875rem 1.15rem;
    background-color: #FDF2F2;
    border: 1px solid #F8B4B4;
    border-radius: var(--radius-sm);
    color: #9B1C1C;
    font-size: 0.84375rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  /* ==========================================================================
     Contact Enquiry Success Notification Card
     Spacious horizontal layout on desktop, responsive stacking on mobile
     ========================================================================== */
  .inquiry-success-card {
    width: 100%;
    margin-top: 1.5rem;
    padding: 1.35rem 1.5rem;
    background-color: var(--color-success-bg, #EDF7EE);
    border: 1px solid rgba(53, 93, 72, 0.2);
    border-left: 4px solid var(--color-forest, #355D48);
    border-radius: var(--radius-sm, 6px);
    box-sizing: border-box;
    display: none;
    flex-direction: column;
    gap: 1rem;
    animation: fadeIn 0.3s ease-out forwards;
  }

  .inquiry-success-card.is-active,
  .inquiry-success-card[style*="display: block"],
  .inquiry-success-card[style*="display: flex"] {
    display: flex !important;
  }

  /* ROW 1: Success Icon + Header & Acknowledgement Text */
  .inquiry-success-header-row {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    width: 100%;
    min-width: 0;
  }

  .inquiry-success-icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: #D4EDDA;
    color: var(--color-forest, #355D48);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .inquiry-success-text-wrap {
    flex: 1 1 0;
    min-width: 0;
  }

  .inquiry-success-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-forest, #355D48);
    margin: 0 0 0.35rem 0;
    line-height: 1.3;
    font-family: var(--font-serif, 'Playfair Display', serif);
  }

  .inquiry-success-desc {
    font-size: 0.90625rem;
    color: var(--color-charcoal, #232B25);
    line-height: 1.55;
    margin: 0;
    width: 100%;
  }

  /* ROW 2: Full Width Highlighted Notice Clarification Box */
  .inquiry-success-notice-box {
    width: 100%;
    box-sizing: border-box;
    background-color: #FEF9E7;
    border: 1.5px solid #F9E79F;
    border-radius: var(--radius-xs, 4px);
    padding: 0.75rem 1rem;
    font-size: 0.84375rem;
    color: #7D6608;
    line-height: 1.5;
  }

  .inquiry-success-notice-box strong {
    color: #5D4037;
  }

  /* ROW 3: Neatly Aligned Action Row */
  .inquiry-success-action-row {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 480px) {
    .inquiry-success-card {
      padding: 1.15rem 1.1rem;
      gap: 0.85rem;
    }
    .inquiry-success-header-row {
      gap: 0.65rem;
    }
    .inquiry-success-icon-wrap {
      width: 32px;
      height: 32px;
    }
    .inquiry-success-icon-wrap svg {
      width: 18px;
      height: 18px;
    }
    .inquiry-success-title {
      font-size: 1.05rem;
    }
    .inquiry-success-desc {
      font-size: 0.875rem;
    }
    .inquiry-success-action-row .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  function setupInquiryForm() {
    const form = document.getElementById('inquiryForm') as HTMLFormElement | null;
    const successBox = document.getElementById('inquirySuccess');
    const waLink = document.getElementById('inqWhatsAppLink') as HTMLAnchorElement | null;
    const submitBtn = document.getElementById('inqSubmitBtn') as HTMLButtonElement | null;
    const submitText = document.getElementById('inqSubmitText');
    const errorAlert = document.getElementById('inquiryErrorAlert');
    const errorMessage = document.getElementById('inquiryErrorMessage');

    if (!form || !successBox) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      let isValid = true;

      if (errorAlert) errorAlert.style.display = 'none';

      const nameInput = document.getElementById('inqName') as HTMLInputElement;
      const phoneInput = document.getElementById('inqPhone') as HTMLInputElement;
      const interestSelect = document.getElementById('inqInterest') as HTMLSelectElement;
      const msgInput = document.getElementById('inqMessage') as HTMLTextAreaElement;
      const hpInput = document.getElementById('contact_hp') as HTMLInputElement;

      const name = nameInput.value.trim();
      const phone = phoneInput.value.trim();
      const cleanPhone = phone.replace(/[\s\-\+]/g, '');
      const interest = interestSelect.value;
      const message = msgInput.value.trim();
      const website_hp = hpInput ? hpInput.value : '';

      if (!name || name.length < 2) {
        nameInput.classList.add('is-invalid');
        isValid = false;
      } else {
        nameInput.classList.remove('is-invalid');
      }

      if (!phone || !/^[6-9]\d{9}$/.test(cleanPhone)) {
        phoneInput.classList.add('is-invalid');
        isValid = false;
      } else {
        phoneInput.classList.remove('is-invalid');
      }

      if (!message || message.length < 3) {
        msgInput.classList.add('is-invalid');
        isValid = false;
      } else {
        msgInput.classList.remove('is-invalid');
      }

      if (!isValid) return;

      // Loading state
      if (submitBtn) submitBtn.disabled = true;
      if (submitText) submitText.textContent = 'Submitting Inquiry...';

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            inqName: name,
            inqPhone: phone,
            inqInterest: interest,
            inqMessage: message,
            website_hp,
          }),
        });

        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result.success) {
          const errMsg = result.error || 'Unable to submit your inquiry at this moment. Please connect via WhatsApp or phone.';
          if (errorAlert && errorMessage) {
            errorMessage.textContent = errMsg;
            errorAlert.style.display = 'block';
          }
          if (submitBtn) submitBtn.disabled = false;
          if (submitText) submitText.textContent = 'Submit Inquiry';
          return;
        }

        const textPayload = `Hello Ekansh Clinic,\n\nI have submitted an inquiry from the website:\n- Name: ${name}\n- Phone: ${phone}\n- Topic: ${interest}\n- Message: ${message}`;
        if (waLink) {
          waLink.href = `https://wa.me/919799988138?text=${encodeURIComponent(textPayload)}`;
        }

        successBox.classList.add('is-active');
        successBox.style.display = 'flex';
        form.reset();

      } catch (networkErr) {
        if (errorAlert && errorMessage) {
          errorMessage.textContent = 'Network or connection error. Please reach out to us directly via WhatsApp (+91 97999 88138).';
          errorAlert.style.display = 'block';
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (submitText) submitText.textContent = 'Submit Inquiry';
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupInquiryForm);
</script>
