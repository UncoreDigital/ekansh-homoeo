---
interface Props {
  activeNav?: string;
}

const { activeNav = "home" } = Astro.props;

const navLinks = [
  { name: "Home", href: "/", id: "home" },
  { name: "About the Clinic", href: "/about", id: "about" },
  { name: "Services", href: "/services", id: "services" },
  { name: "FAQs", href: "/faqs", id: "faqs" },
  { name: "Contact & Location", href: "/contact", id: "contact" },
];


---

<header class="site-header">
  <div class="top-announcement-bar">
    <div class="container top-bar-inner">

      <!-- Location -->
      <span class="top-bar-item top-location">
        <svg class="top-icon" viewBox="0 0 24 24" width="14" height="14"
          fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span class="location-full hide-on-mobile">Near Vijay Travels, Kankroli, Rajsamand • In-Clinic &amp; Online Tele-Consultations</span>
        <span class="location-short hide-on-desktop">Kankroli, Rajsamand</span>
      </span>

      <!-- Clinic Timings -->
      <span class="top-bar-item top-timings hide-on-mobile">
        <svg class="top-icon" viewBox="0 0 24 24" width="14" height="14"
          fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>Mon–Sat: 10 AM – 2 PM, 4 – 8 PM • Sun: 10 AM – 2 PM</span>
      </span>

      <!-- Phone Numbers -->
      <span class="top-bar-item top-phone-links">
        <a href="tel:+919799988138" class="top-bar-link"
          aria-label="Call clinic at +91 9799988138">
          <svg class="top-icon" viewBox="0 0 24 24" width="14" height="14"
            fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span class="phone-text">9799988138</span>
        </a>

        <span class="phone-divider hide-on-mobile" aria-hidden="true">|</span>

        <a href="tel:+919521646525" class="top-bar-link hide-on-mobile"
          aria-label="Call clinic at +91 9521646525">
          <svg class="top-icon" viewBox="0 0 24 24" width="14" height="14"
            fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span class="phone-text">9521646525</span>
        </a>
      </span>

    </div>
  </div>

  <!-- Main Navbar -->
  <nav class="main-nav" aria-label="Main Navigation">
    <div class="container nav-container">
      <!-- Official Clinic Logo -->
      <a href="/" class="brand-link" aria-label="Ekansh Homoeopathic Clinic Homepage">
        <img 
          src="/images/LOGO2.png" 
          alt="Ekansh Homoeopathic Clinic" 
          class="site-logo-img" 
          width="180" 
          height="54" 
          loading="eager"
        />
      </a>

      <!-- Desktop Navigation Links -->
      <ul class="nav-links hide-on-mobile" role="list">
        {navLinks.map((link) => (
          <li>
            <a 
              href={link.href} 
              class={`nav-link ${activeNav === link.id ? 'is-active' : ''}`}
            >
              {link.name}
            </a>
          </li>
        ))}
      </ul>

      <!-- Primary Action CTA (High Visibility) -->
      <div class="nav-action hide-on-mobile">
        <a href="/book-consultation" class="btn btn-primary btn-sm nav-cta-btn">
          <span>Book Consultation</span>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <button 
        type="button" 
        class="mobile-menu-toggle hide-on-desktop" 
        id="mobileMenuToggle" 
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobileDrawer"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Off-Canvas Drawer -->
  <div class="mobile-drawer-overlay" id="mobileDrawerOverlay"></div>
  <aside class="mobile-drawer" id="mobileDrawer" aria-hidden="true">
    <div class="drawer-header">
      <a href="/" class="drawer-brand-link">
        <img 
          src="/images/LOGO2.png" 
          alt="Ekansh Homoeopathic Clinic" 
          class="drawer-logo-img" 
          width="150" 
          height="45" 
        />
      </a>
      <button type="button" class="drawer-close" id="drawerClose" aria-label="Close menu">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="drawer-body">
      <!-- Quick Booking CTA for Mobile -->
      <div class="drawer-primary-cta">
        <a href="/book-consultation" class="btn btn-primary btn-lg" style="width: 100%;">
          <span>Book a Consultation</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <ul class="drawer-nav-list" role="list">
        {navLinks.map((link) => (
          <li>
            <a 
              href={link.href} 
              class={`drawer-nav-link ${activeNav === link.id ? 'is-active' : ''}`}
            >
              {link.name}
            </a>
          </li>
        ))}
      </ul>

      <div class="drawer-info-block">
        <p class="drawer-info-title">Ekansh Clinic Timings</p>
        <p class="drawer-info-text">Mon – Sat: 10:00 AM – 2:00 PM &bull; 4:00 PM – 8:00 PM<br/>Sunday: 10:00 AM – 2:00 PM</p>
        <p class="drawer-info-text" style="font-size: 0.75rem; margin-top: 0.35rem; color: var(--color-charcoal-muted);">
          Near Vijay Travels, Vivekanand Choraya, Bhilwara Road, Kankroli, Rajsamand – 313324
        </p>
        <div class="drawer-contact-links">
          <a href="tel:+919799988138" class="drawer-contact-pill">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            +91 9799988138
          </a>
          <a href="tel:+919521646525" class="drawer-contact-pill">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            +91 9521646525
          </a>
          <a href="https://wa.me/919799988138?text=Hello%20Ekansh%20Clinic,%20I%20would%20like%20to%20enquire%20about%20a%20consultation." target="_blank" rel="noopener noreferrer" class="drawer-contact-pill whatsapp">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            WhatsApp Desk
          </a>
        </div>
      </div>
    </div>
  </aside>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: var(--color-ivory);
    box-shadow: 0 2px 12px rgba(48, 56, 50, 0.06);
  }

  /* Top Quick Announcement Bar */
  .top-announcement-bar {
    background-color: var(--color-forest);
    color: var(--color-ivory);
    font-size: 0.78125rem;
    padding: 0.35rem 0;
    letter-spacing: 0.02em;
  }

  .top-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .top-bar-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .top-icon {
    color: var(--color-sage);
    flex-shrink: 0;
  }

  .top-bar-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-gold-light);
    font-weight: 600;
  }

  .top-bar-link:hover {
    color: var(--color-white);
  }

  /* Main Nav */
  .main-nav {
    background-color: rgba(246, 245, 239, 0.98);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-beige);
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
    gap: 1.5rem;
  }

  /* Logo Image */
  .brand-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-logo-img {
    height: 54px;
    width: auto;
    max-width: 180px;
    object-fit: contain;
    display: block;
    transition: transform var(--transition-fast);
  }

  .site-logo-img:hover {
    transform: scale(1.02);
  }

  @media (max-width: 991px) {
    .site-logo-img {
      height: 44px;
      max-width: 150px;
    }
  }

  /* Nav Links */
  .nav-links {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 1.5rem;
  }

  .nav-link {
    font-size: 0.90625rem;
    font-weight: 500;
    color: var(--color-charcoal);
    position: relative;
    padding: 0.5rem 0;
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-accent-red);
  }

  .nav-link.is-active {
    color: var(--color-forest);
    font-weight: 700;
  }

  .nav-link.is-active::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2.5px;
    background-color: var(--color-accent-red);
    border-radius: var(--radius-full);
  }

  /* Nav CTA */
  .nav-cta-btn {
    box-shadow: 0 4px 14px rgba(53, 93, 72, 0.28);
    font-weight: 600;
  }

  /* Mobile Toggle */
  .mobile-menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    padding: 10px;
    border-radius: var(--radius-sm);
    background-color: var(--color-white);
    border: 1px solid var(--color-beige);
  }

  .hamburger-bar {
    width: 100%;
    height: 2px;
    background-color: var(--color-forest);
    border-radius: 2px;
  }

  /* Mobile Drawer */
  .mobile-drawer-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(48, 56, 50, 0.5);
    backdrop-filter: blur(4px);
    z-index: 1050;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-base), visibility var(--transition-base);
  }

  .mobile-drawer-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 85%;
    max-width: 360px;
    background-color: var(--color-ivory);
    z-index: 1100;
    box-shadow: var(--shadow-drawer);
    transform: translateX(100%);
    transition: transform var(--transition-slow);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .mobile-drawer.is-open {
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-beige);
  }

  .drawer-logo-img {
    height: 42px;
    width: auto;
    object-fit: contain;
  }

  .drawer-close {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-charcoal);
    background-color: var(--color-white);
    border: 1px solid var(--color-beige);
  }

  .drawer-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .drawer-primary-cta {
    margin-bottom: 1.5rem;
  }

  .drawer-nav-list {
    list-style: none;
    margin-bottom: 1.5rem;
  }

  .drawer-nav-link {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-charcoal);
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-beige);
  }

  .drawer-nav-link:hover {
    color: var(--color-accent-red);
  }

  .drawer-nav-link.is-active {
    color: var(--color-accent-red);
  }

  .drawer-info-block {
    background-color: var(--color-white);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-beige);
    padding: 1.125rem;
    margin-top: auto;
  }

  .drawer-info-title {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-forest);
    margin-bottom: 0.25rem;
  }

  .drawer-info-text {
    font-size: 0.78125rem;
    color: var(--color-charcoal-muted);
    margin-bottom: 0.5rem;
  }

  .drawer-contact-links {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .drawer-contact-pill {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-full);
    background-color: var(--color-ivory);
    border: 1px solid var(--color-beige);
    color: var(--color-forest);
  }

  .drawer-contact-pill.whatsapp {
    background-color: var(--color-accent-red-light);
    color: var(--color-accent-red);
    border-color: rgba(169, 88, 69, 0.35);
  }

  /* Top announcement bar */
.top-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.top-bar-item {
  display: flex;
  align-items: center;
  gap: 8px;
}

.top-location {
  flex: 1;
  min-width: 0;
}

.top-location > span {
  line-height: 1.5;
}

.top-phone-links {
  flex-shrink: 0;
  gap: 12px;
  white-space: nowrap;
}

.top-bar-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  white-space: nowrap;
}

/* Mobile layout */
@media (max-width: 767px) {
  .top-announcement-bar {
    padding: 0.25rem 0;
  }

  .top-bar-inner {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
  }

  .top-location {
    flex: 1;
    min-width: 0;
    align-items: center;
    font-size: 0.72rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .top-location .top-icon {
    flex-shrink: 0;
    margin-top: 0;
  }

  .location-short {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 0.72rem;
  }

  .top-phone-links {
    flex-shrink: 0;
    gap: 6px;
    font-size: 0.72rem;
  }

  .top-phone-links .top-icon {
    width: 12px;
    height: 12px;
  }

  .top-bar-link {
    gap: 4px;
    font-size: 0.72rem;
  }

  .nav-container {
    height: 58px;
  }

  .site-logo-img {
    height: 38px;
    max-width: 135px;
  }

  .mobile-menu-toggle {
    width: 44px;
    height: 44px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    flex-shrink: 0;
  }

  .drawer-contact-links {
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  .drawer-contact-pill {
    width: 100%;
  }

  .hide-on-mobile {
    display: none !important;
  }
}
</style>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobileMenuToggle');
    const closeBtn = document.getElementById('drawerClose');
    const drawer = document.getElementById('mobileDrawer');
    const overlay = document.getElementById('mobileDrawerOverlay');

    if (!toggleBtn || !drawer || !overlay) return;

    function openMenu() {
      drawer.classList.add('is-open');
      overlay.classList.add('is-open');
      toggleBtn.setAttribute('aria-expanded', 'true');
      drawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');
      toggleBtn.setAttribute('aria-expanded', 'false');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // Remove existing listeners if already bound
    toggleBtn.onclick = openMenu;
    if (closeBtn) closeBtn.onclick = closeMenu;
    overlay.onclick = closeMenu;

    // Close menu when any drawer link is selected
    drawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
        closeMenu();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileMenu);
  } else {
    setupMobileMenu();
  }
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
