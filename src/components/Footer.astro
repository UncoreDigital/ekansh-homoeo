---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- Pre-footer Botanical Wave / Border -->
  <div class="footer-top-accent"></div>

  <div class="container footer-main">
    <div class="footer-grid">
      <!-- Col 1: Brand Info -->
      <div class="footer-col brand-col">
        <div class="footer-brand">
          <div class="footer-logo-icon">
            <svg viewBox="0 0 32 32" width="24" height="24" fill="none" stroke="currentColor">
              <path d="M16 28V12" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/>
              <path d="M16 18C12 16 7 18 5 22C10 23 15 20 16 18Z" fill="#A3B18A" fill-opacity="0.5" stroke="#FFFFFF" stroke-width="1.5"/>
              <path d="M16 14C20 12 25 14 27 18C22 19 17 16 16 14Z" fill="#B9A77D" fill-opacity="0.5" stroke="#FFFFFF" stroke-width="1.5"/>
              <circle cx="16" cy="8" r="4" fill="#FFFFFF"/>
            </svg>
          </div>
          <div>
            <h3 class="footer-brand-name">EKANSH</h3>
            <span class="footer-brand-descriptor">HOMOEOPATHIC CLINIC</span>
          </div>
        </div>
        
        <p class="footer-tagline">"Care That Begins With Listening."</p>
        
        <p class="footer-desc">
          Individualised constitutional homeopathic healthcare rooted in patient empathy, clinical depth, and unhurried consultations. Serving Rajsamand locally and patients worldwide online.
        </p>

        <div class="footer-badge-wrap">
          <span class="badge badge-sage">Rajsamand, Rajasthan, India</span>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="footer-col">
        <h4 class="footer-heading">Explore Clinic</h4>
        <ul class="footer-links" role="list">
          <li><a href="/">Home</a></li>
          <li><a href="/about">About the Doctor</a></li>
          <li><a href="/approach">Our Clinical Approach</a></li>
          <li><a href="/services">Consultation Services</a></li>
          <li><a href="/journal">Health Journal & Insights</a></li>
          <li><a href="/contact">Contact & Location</a></li>
          <li><a href="/book-consultation">Book a Consultation</a></li>
        </ul>
      </div>

      <!-- Col 3: Clinical Services -->
      <div class="footer-col">
        <h4 class="footer-heading">Consultation Options</h4>
        <ul class="footer-links" role="list">
          <li><a href="/services#in-clinic">In-Clinic Consultation (Rajsamand)</a></li>
          <li><a href="/services#online">Online Consultation (Video/Audio)</a></li>
          <li><a href="/services#follow-up">Follow-up Case Review</a></li>
          <li><a href="/services#lifestyle">Constitutional & Lifestyle Guidance</a></li>
          <li><a href="/services#courier">Safe Medicine Courier Policy</a></li>
        </ul>

        <div class="footer-hours-box">
          <p class="hours-title">Clinic Operating Hours</p>
          <p class="hours-line"><span>Mon – Sat:</span> 10:00 AM – 1:00 PM</p>
          <p class="hours-line"><span>Evening:</span> 5:00 PM – 8:00 PM</p>
          <p class="hours-line"><span>Sunday:</span> Prior Appointment</p>
        </div>
      </div>

      <!-- Col 4: Contact & Coordinates -->
      <div class="footer-col">
        <h4 class="footer-heading">Clinic Coordinates</h4>
        <address class="footer-address">
          <p class="address-line">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>Ekansh Homoeopathic Clinic,<br/>Near [Landmark Placeholder],<br/>Rajsamand, Rajasthan – 313324, India</span>
          </p>
          
          <p class="address-line">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <a href="tel:+919876543210">+91 [Clinic Phone Placeholder]</a>
          </p>

          <p class="address-line">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            <a href="https://wa.me/919876543210?text=Hello%20Ekansh%20Clinic,%20I%20would%20like%20to%20enquire%20about%20a%20consultation." target="_blank" rel="noopener noreferrer">WhatsApp Direct Booking</a>
          </p>

          <p class="address-line">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <a href="mailto:care@ekanshclinic.in">care@ekanshclinic.in [Placeholder]</a>
          </p>
        </address>
      </div>
    </div>

    <!-- Statutory Medical & Ayush Disclaimer -->
    <div class="footer-disclaimer-wrap">
      <div class="footer-disclaimer">
        <p class="disclaimer-title">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          Statutory Medical Ethics & Non-Emergency Notice
        </p>
        <p class="disclaimer-text">
          The information presented across this website is provided solely for educational and general wellness awareness. It does not constitute individual medical prescription, formal diagnosis, or guaranteed treatment outcome. Homeopathic remedies are chosen specifically based on constitutional totality and must be taken under the supervision of a certified, registered homoeopathic medical practitioner. In case of acute medical emergencies, trauma, or life-threatening crises, please contact the nearest tertiary hospital or emergency casualty department immediately.
        </p>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="copyright-text">
        &copy; {currentYear} Ekansh Homoeopathic Clinic. All rights reserved. Registered Practice in Rajsamand, Rajasthan, India.
      </p>
      <div class="bottom-links">
        <a href="/about#ethics">Clinical Ethics Code</a>
        <span class="sep">&bull;</span>
        <a href="/approach#telemedicine">Ayush Telemedicine Notice</a>
        <span class="sep">&bull;</span>
        <a href="/contact">Privacy & Consent</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-forest);
    color: var(--color-ivory);
    margin-top: auto;
    position: relative;
  }

  .footer-top-accent {
    height: 4px;
    background: linear-gradient(90deg, var(--color-sage), var(--color-gold), var(--color-sage));
  }

  .footer-main {
    padding-top: clamp(3.5rem, 6vw, 5rem);
    padding-bottom: 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.2fr 1.3fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    margin-bottom: 3.5rem;
  }

  @media (max-width: 991px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 575px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Brand Col */
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .footer-logo-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .footer-brand-name {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-white);
    letter-spacing: 0.05em;
    margin-bottom: 0.1rem;
  }

  .footer-brand-descriptor {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    color: var(--color-sage-light);
    display: block;
  }

  .footer-tagline {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-gold-light);
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }

  .footer-desc {
    font-size: 0.84375rem;
    line-height: 1.6;
    color: rgba(246, 245, 239, 0.8);
    margin-bottom: 1.25rem;
  }

  .footer-badge-wrap .badge {
    background-color: rgba(163, 177, 138, 0.2);
    color: var(--color-sage-light);
    border-color: rgba(163, 177, 138, 0.4);
  }

  /* Headings & Links */
  .footer-heading {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--color-white);
    margin-bottom: 1.25rem;
    position: relative;
    padding-bottom: 0.5rem;
  }

  .footer-heading::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 30px;
    height: 2px;
    background-color: var(--color-gold);
  }

  .footer-links {
    list-style: none;
  }

  .footer-links li {
    margin-bottom: 0.65rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: rgba(246, 245, 239, 0.8);
    transition: color var(--transition-fast), padding-left var(--transition-fast);
    display: inline-block;
  }

  .footer-links a:hover {
    color: var(--color-gold-light);
    padding-left: 4px;
  }

  /* Operating Hours Box */
  .footer-hours-box {
    margin-top: 1.25rem;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-sm);
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .hours-title {
    font-family: var(--font-serif);
    font-size: 0.84375rem;
    color: var(--color-gold-light);
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  .hours-line {
    font-size: 0.78125rem;
    color: rgba(246, 245, 239, 0.85);
    margin-bottom: 0.2rem;
    display: flex;
    justify-content: space-between;
  }

  .hours-line span {
    color: var(--color-sage-light);
  }

  /* Address & Contact */
  .footer-address {
    font-style: normal;
  }

  .address-line {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: 0.84375rem;
    line-height: 1.5;
    color: rgba(246, 245, 239, 0.85);
    margin-bottom: 0.875rem;
  }

  .address-line svg {
    color: var(--color-gold-light);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .address-line a {
    color: rgba(246, 245, 239, 0.9);
  }

  .address-line a:hover {
    color: var(--color-gold-light);
  }

  /* Disclaimer Box */
  .footer-disclaimer-wrap {
    margin-bottom: 2.5rem;
  }

  .footer-disclaimer {
    background-color: rgba(0, 0, 0, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
    padding: 1.25rem 1.5rem;
  }

  .disclaimer-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.84375rem;
    font-weight: 600;
    color: var(--color-gold-light);
    margin-bottom: 0.4rem;
  }

  .disclaimer-title svg {
    color: var(--color-gold-light);
  }

  .disclaimer-text {
    font-size: 0.78125rem;
    line-height: 1.6;
    color: rgba(246, 245, 239, 0.75);
    margin-bottom: 0;
  }

  /* Bottom Bar */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.78125rem;
    color: rgba(246, 245, 239, 0.65);
  }

  .bottom-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .bottom-links a {
    color: rgba(246, 245, 239, 0.7);
  }

  .bottom-links a:hover {
    color: var(--color-gold-light);
  }

  .bottom-links .sep {
    color: rgba(255, 255, 255, 0.3);
  }
</style>
