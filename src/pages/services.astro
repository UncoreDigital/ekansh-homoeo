---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const servicesFAQs = [
  {
    question: "What are the consultation fees for in-clinic and online visits?",
    answer: "Consultation fees are established transparently and include comprehensive case analysis and repertorisation. Please contact the clinic via phone or WhatsApp for current verified fee schedules (Reference: docs/PENDING_INFORMATION.md)."
  },
  {
    question: "How does the medicine courier service operate for online patients?",
    answer: "Following your video consultation and remedy selection, medications are dispensed from our certified clinic stock, sealed with tamper-evident packaging, and dispatched via speed courier with tracking coordinates sent to your WhatsApp or email."
  },
  {
    question: "How frequently will I need follow-up consultations?",
    answer: "For chronic conditions, follow-ups are typically scheduled every 3 to 4 weeks. Acute or seasonal conditions are monitored over closer intervals of 3 to 7 days."
  },
  {
    question: "What if I experience an acute symptom flare-up between appointments?",
    answer: "Existing registered patients can reach out via WhatsApp messaging during clinic operating hours. The doctor reviews message updates and advises whether a quick acute dose or early follow-up is warranted."
  }
];
---

<BaseLayout 
  title="Consultation Services | Ekansh Homoeopathic Clinic, Rajsamand"
  description="Explore comprehensive in-clinic and online homeopathic consultation options at Ekansh Homoeopathic Clinic in Rajsamand. Unhurried case-taking, follow-up care, and courier delivery."
  activeNav="services"
>
  <!-- Page Header -->
  <section class="page-header-section">
    <div class="container text-center">
      <span class="text-eyebrow">Comprehensive Patient Care</span>
      <h1 class="page-title">Consultation Services</h1>
      <p class="page-subtitle text-lead">
        Structured clinical pathways designed to give you unhurried, personalized attention—whether visiting our Rajsamand clinic in person or connecting online from across India.
      </p>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="section-padding">
    <div class="container">
      <div class="verification-callout" style="max-width: 900px; margin: 0 auto 3rem;">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <div>
          <strong>Transparent Pricing Notice:</strong> In adherence to medical ethics and consumer disclosure guidelines, standard consultation fee amounts are verified directly with the practitioner. No hidden dispensary charges or unnecessary packaging fees are levied.
        </div>
      </div>

      <div class="services-full-grid">
        <!-- Service 1: In-Clinic -->
        <div id="in-clinic">
          <ServiceCard 
            title="In-Clinic Initial Consultation"
            badge="Rajsamand Practice"
            duration="45 – 60 Minutes"
            description="Our flagship face-to-face clinical intake session conducted in our quiet, serene Rajsamand consulting room. Ideal for patients seeking deep constitutional evaluation for chronic or recurring illnesses."
            features={[
              "Comprehensive 45-60 min physical, mental & emotional case-taking",
              "Personalized constitutional repertorisation by the doctor",
              "Direct dispensation of high-grade medicated globules/dilutions",
              "Customized dietary, lifestyle and antidote precautions",
              "Printed case summary & instructions"
            ]}
            feePlaceholder="₹ [Verified On Request]"
            isPopular={true}
            ctaText="Book Clinic Appointment"
            ctaHref="/book-consultation?mode=in-clinic"
          />
        </div>

        <!-- Service 2: Online Tele-Consultation -->
        <div id="online">
          <ServiceCard 
            title="Online Tele-Consultation"
            badge="Nationwide Video / Audio"
            duration="45 – 60 Minutes"
            description="A thorough, digital consultation conducted via secure video (Google Meet / WhatsApp Video) or high-clarity voice call for outstation patients across Rajasthan, India, and overseas."
            features={[
              "Identical 45-60 min clinical depth as in-clinic sessions",
              "Ayush Telemedicine Guidelines compliant digital record",
              "Tamper-proof medical packaging and safe doorstep dispatch",
              "Speed courier tracking details provided to patient",
              "Direct WhatsApp follow-up support channel"
            ]}
            feePlaceholder="₹ [Verified On Request]"
            isPopular={false}
            ctaText="Book Online Session"
            ctaHref="/book-consultation?mode=online"
          />
        </div>

        <!-- Service 3: Follow-Up Review -->
        <div id="follow-up">
          <ServiceCard 
            title="Follow-Up Case Review"
            badge="In-Clinic or Online"
            duration="15 – 20 Minutes"
            description="Crucial progress review scheduled 3 to 4 weeks after the initial remedy prescription to evaluate shifts in your vital force, symptom improvement, and constitutional stability."
            features={[
              "Detailed assessment of symptom scorecards and energy levels",
              "Application of Hering’s Law of Cure to track internal progress",
              "Potency adjustment, remedy repetition, or complementary dosing",
              "Refinement of nutritional and sleep guidelines",
              "Refill remedy dispensation or dispatch"
            ]}
            feePlaceholder="₹ [Verified On Request]"
            isPopular={false}
            ctaText="Schedule Follow-Up"
            ctaHref="/book-consultation"
          />
        </div>

        <!-- Service 4: Acute & Guidance -->
        <div id="lifestyle">
          <ServiceCard 
            title="Acute Ailment & Preventive Care"
            badge="Established Patients"
            duration="20 – 30 Minutes"
            description="Focused consultation for sudden seasonal ailments (e.g. seasonal coughs, viral fevers, allergic bouts, acute tummy upsets) or targeted preventive wellness coaching."
            features={[
              "Fast, targeted analysis of acute modality triggers",
              "Prescription of specific acute supportive remedies",
              "Hydration, steam, and therapeutic diet guidance",
              "Close 48-hour telephonic monitoring where needed",
              "Seamless integration with ongoing constitutional treatment"
            ]}
            feePlaceholder="₹ [Verified On Request]"
            isPopular={false}
            ctaText="Request Acute Care"
            ctaHref="/book-consultation"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Medicine Courier & Delivery Policy Section -->
  <section class="section-padding courier-section" id="courier">
    <div class="container">
      <div class="courier-card card-editorial card-forest">
        <div class="courier-grid">
          <div>
            <span class="text-eyebrow" style="color: var(--color-gold-light);">Safe Medicine Dispatch</span>
            <h2 style="color: var(--color-white); margin-top: 0.5rem; margin-bottom: 1rem;">
              Nationwide Medicine Delivery Protocol
            </h2>
            <p style="color: rgba(246, 245, 239, 0.9); line-height: 1.6; margin-bottom: 1.5rem;">
              For our online patients outside Rajsamand, we ensure that every prescribed remedy is dispensed directly from our clinic, packaged securely to protect against aroma and moisture contamination, and delivered safely to your doorstep.
            </p>
            <div class="courier-checks">
              <div class="check-item">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Dispensed from sealed, certified homeopathic pharmacopeia stock</span>
              </div>
              <div class="check-item">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Insulated tamper-evident packing protecting from heat & strong odors</span>
              </div>
              <div class="check-item">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Dispatched via India Post Speed Post / Reputed Courier with tracking</span>
              </div>
            </div>
          </div>

          <div class="courier-side-card">
            <div class="delivery-time-box">
              <span class="d-title">Estimated Transit Timelines</span>
              <div class="d-line">
                <span>Rajasthan (Udaipur, Jaipur, Jodhpur):</span>
                <strong>24 to 48 Hours</strong>
              </div>
              <div class="d-line">
                <span>Major Metros (Delhi, Mumbai, Bengaluru):</span>
                <strong>2 to 4 Days</strong>
              </div>
              <div class="d-line">
                <span>Rest of India & Remote Districts:</span>
                <strong>3 to 5 Days</strong>
              </div>
              <p class="d-note">* Dispatch tracking link provided via WhatsApp / SMS immediately upon booking.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="section-padding faq-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="text-eyebrow">Answers for Patients</span>
        <h2>Consultation Services FAQ</h2>
      </div>

      <FAQAccordion items={servicesFAQs} />

      <div class="faq-cta text-center" style="margin-top: 2.5rem;">
        <a href="/book-consultation" class="btn btn-primary btn-lg">
          Schedule Your Chosen Consultation
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header-section {
    padding: clamp(3rem, 6vw, 5rem) 0 2rem;
    background: radial-gradient(circle at top center, rgba(163, 177, 138, 0.18), transparent 70%);
    border-bottom: 1px solid var(--color-beige);
  }

  .page-title {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    color: var(--color-forest);
  }

  .page-subtitle {
    max-width: 680px;
    margin: 0 auto;
  }

  .services-full-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  @media (max-width: 900px) {
    .services-full-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Courier Section */
  .courier-card {
    padding: clamp(2rem, 4vw, 3.5rem);
  }

  .courier-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .courier-grid {
      grid-template-columns: 1fr;
    }
  }

  .courier-checks {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .check-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.875rem;
    color: var(--color-ivory);
  }

  .check-item svg {
    color: var(--color-gold-light);
    flex-shrink: 0;
  }

  .delivery-time-box {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
  }

  .d-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--color-gold-light);
    display: block;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .d-line {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-ivory);
  }

  .d-line strong {
    color: var(--color-sage-light);
  }

  .d-note {
    font-size: 0.71875rem;
    color: rgba(246, 245, 239, 0.7);
    margin-top: 0.85rem;
    margin-bottom: 0;
  }
</style>
