---
/**
 * Ekansh Homoeopathic Clinic - Testimonials Carousel
 *
 * Powered by Swiper:
 * - Displays 1 testimonial at a time (stars, review, and name)
 * - Automatic sliding every 5 seconds with infinite looping
 * - Pagination dots with active pill indicator & prev/next arrows
 * - Touch & swipe navigation on mobile, pauses on hover/focus
 */
import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/pagination';

const testimonials = [
  {
    quote: "I’ve been taking treatment for my thyroid for the past 2 months, and my reports have shown positive improvement. Really happy with the results. The doctor is very kind and supportive. Highly recommended!",
    patientName: "Isha Sharma"
  },
  {
    quote: "I visited this homoeopathic doctor for chest burning (jalan), and I am very happy with the treatment. The doctor listened to my symptoms patiently and explained everything clearly. The medicines worked well, and I started feeling much better within a few weeks. The doctor is caring, professional, and gives enough time to every patient. I highly recommend this doctor to anyone looking for effective homoeopathic treatment.",
    patientName: "Kuldeep Kumawat"
  },
  {
    quote: "My experience at this clinic has been very good. I consulted the doctor here and explained my health concern in detail. After following the prescribed treatment and taking the medicines, I experienced positive results. My condition has improved significantly, and my health issue has been effectively resolved.",
    patientName: "Sapna Kamad"
  },
  {
    quote: "My personal experience with Dr Akshat Chaplot had been extraordinary. He listened to all my problems very patiently by giving me enough time on my first consultation. In fact I was having multiple problems like bloating, lower back ache, constipation, etc. Subsequently the remedies prescribed were very effective and helped reduce my symptoms considerably. Thanks to his care I feel relieved.",
    patientName: "Rajiv Ranjan Kumar"
  },
  {
    quote: "Had wonderful experience with homeopathic medicine by Dr. Akshat for retinal complaint. Was having vision discomfort for which I was suggested surgery, but with detailed consideration of my case and homeopathy medicine my vision feels much better and scan reports have shown clear progress. Highly recommend for those needing patient, thorough consultation.",
    patientName: "Jesk Sen"
  },
  {
    quote: "I was experiencing severe eczema around my mouth, ears and other areas with extreme dryness. After treatment given by Dr. Akshat there was remarkable improvement over two months. Now I feel confident about myself. Very grateful for his care.",
    patientName: "Preksha Mehta"
  },
];
---

<div class="testimonial-carousel-container" id="testimonialCarousel">
  <!-- Carousel Outer Layout with Flanking Subtle Navigation Arrows -->
  <div class="carousel-outer-wrapper">
    <!-- Subtle Previous Arrow -->
    <button 
      type="button" 
      class="carousel-nav-btn carousel-prev" 
      aria-label="Previous testimonial"
      title="Previous testimonial"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <!-- Swiper Viewport -->
    <div class="swiper testimonial-swiper">
      <div class="swiper-wrapper">
        {testimonials.map((item) => (
          <div class="swiper-slide">
            <div class="testimonial-card card-editorial">
              <!-- Decorative Large Quotation Mark Watermark -->
              <div class="quote-accent-mark" aria-hidden="true">&ldquo;</div>

              <div class="testimonial-top">
                <div class="stars" aria-label="5 out of 5 stars rating">
                  <span class="star">&#9733;</span>
                  <span class="star">&#9733;</span>
                  <span class="star">&#9733;</span>
                  <span class="star">&#9733;</span>
                  <span class="star">&#9733;</span>
                </div>
              </div>

              <blockquote class="testimonial-quote">
                &ldquo;{item.quote}&rdquo;
              </blockquote>

              <div class="testimonial-footer">
                <p class="patient-name">&mdash; {item.patientName}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Subtle Next Arrow -->
    <button 
      type="button" 
      class="carousel-nav-btn carousel-next" 
      aria-label="Next testimonial"
      title="Next testimonial"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>

  <!-- Swiper Custom Pagination Dots (Centered Below) -->
  <div class="swiper-pagination testimonial-pagination"></div>
</div>

<script>
  import Swiper from 'swiper';
  import { Autoplay, Navigation, Pagination } from 'swiper/modules';

  function initTestimonialCarousel() {
    const container = document.getElementById('testimonialCarousel');
    const swiperEl = container ? container.querySelector('.testimonial-swiper') as HTMLElement : null;
    if (!swiperEl) return;

    if ((swiperEl as any).swiper) {
      try {
        (swiperEl as any).swiper.destroy(true, true);
      } catch (e) {
        // Safe fallback
      }
    }

    const swiper = new Swiper(swiperEl, {
      modules: [Autoplay, Navigation, Pagination],
      slidesPerView: 1,
      spaceBetween: 28,
      loop: true,
      speed: 650,
      grabCursor: true,
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
      navigation: {
        nextEl: '.carousel-next',
        prevEl: '.carousel-prev',
      },
      pagination: {
        el: '.testimonial-pagination',
        clickable: true,
        renderBullet: function (index, className) {
          return `<button type="button" class="${className}" aria-label="Go to testimonial ${index + 1}"></button>`;
        },
      },
      a11y: {
        prevSlideMessage: 'Previous testimonial',
        nextSlideMessage: 'Next testimonial',
      },
    });

    if (container) {
      container.addEventListener('mouseenter', () => swiper?.autoplay?.stop());
      container.addEventListener('mouseleave', () => swiper?.autoplay?.start());
      container.addEventListener('focusin', () => swiper?.autoplay?.stop());
      container.addEventListener('focusout', () => swiper?.autoplay?.start());
      container.addEventListener('touchstart', () => swiper?.autoplay?.stop(), { passive: true });
      container.addEventListener('touchend', () => {
        setTimeout(() => swiper?.autoplay?.start(), 3000);
      }, { passive: true });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTestimonialCarousel);
  } else {
    initTestimonialCarousel();
  }
</script>

<style>
  .testimonial-carousel-container {
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    position: relative;
  }

  .carousel-outer-wrapper {
    position: relative;
    width: 100%;
    padding: 0 3.25rem;
    box-sizing: border-box;
    display: flex;
    align-items: center;
  }

  .testimonial-swiper {
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-md, 8px);
    position: relative;
    min-height: 290px;
  }

  .swiper-wrapper {
    align-items: stretch;
  }

  .swiper-slide {
    height: auto;
    display: flex;
    justify-content: center;
    align-items: stretch;
  }

  .testimonial-card {
    background-color: var(--color-white, #FFFFFF);
    border: 1px solid var(--color-beige, #E9E4D7);
    border-radius: var(--radius-md, 8px);
    padding: clamp(1.75rem, 4vw, 2.5rem);
    width: 100%;
    position: relative;
    box-shadow: 0 10px 32px -4px rgba(48, 56, 50, 0.05);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 290px;
    box-sizing: border-box;
    transition: transform var(--transition-fast, 180ms ease);
  }

  .quote-accent-mark {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    font-family: var(--font-serif, 'Playfair Display', Georgia, serif);
    font-size: 5rem;
    line-height: 1;
    color: var(--color-gold, #B9A77D);
    opacity: 0.22;
    pointer-events: none;
    user-select: none;
  }

  .testimonial-top {
    display: flex;
    align-items: center;
    margin-bottom: 1rem;
  }

  .stars {
    color: var(--color-gold, #B9A77D);
    font-size: 1.15rem;
    letter-spacing: 2px;
    line-height: 1;
  }

  .testimonial-quote {
    font-family: var(--font-serif, 'Playfair Display', Georgia, serif);
    font-style: italic;
    font-size: clamp(1.05rem, 2.2vw, 1.28rem);
    line-height: 1.65;
    color: var(--color-charcoal, #303832);
    margin: 0.25rem 0 1.5rem 0;
    flex-grow: 1;
    position: relative;
    z-index: 1;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .testimonial-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--color-beige, #E9E4D7);
  }

  .patient-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-forest, #355D48);
    margin: 0;
  }

  .carousel-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--color-white, #FFFFFF);
    border: 1px solid var(--color-beige-dark, #D8D2C2);
    color: var(--color-forest, #355D48);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: all var(--transition-fast, 180ms ease);
    box-shadow: 0 4px 14px rgba(48, 56, 50, 0.06);
    padding: 0;
  }

  .carousel-prev {
    left: 0;
  }

  .carousel-next {
    right: 0;
  }

  .carousel-nav-btn:hover {
    background-color: var(--color-forest, #355D48);
    color: var(--color-ivory, #F6F5EF);
    border-color: var(--color-forest, #355D48);
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 6px 18px rgba(30, 61, 47, 0.15);
  }

  .carousel-nav-btn:active {
    transform: translateY(-50%) scale(0.96);
  }

  .carousel-nav-btn:focus-visible {
    outline: 2px solid var(--color-forest, #355D48);
    outline-offset: 2px;
  }

  .testimonial-pagination {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    position: relative;
  }

  :global(.testimonial-pagination .swiper-pagination-bullet) {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: var(--color-beige-dark, #D4CCB8);
    opacity: 0.65;
    border: none;
    margin: 0 !important;
    padding: 0;
    cursor: pointer;
    transition: all 260ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.testimonial-pagination .swiper-pagination-bullet:hover) {
    opacity: 0.95;
    background-color: var(--color-sage-dark, #5A6D52);
  }

  :global(.testimonial-pagination .swiper-pagination-bullet-active) {
    width: 32px;
    height: 10px;
    border-radius: 5px;
    background-color: var(--color-forest, #355D48);
    opacity: 1;
    box-shadow: 0 2px 8px rgba(53, 93, 72, 0.28);
  }

  @media (max-width: 680px) {
    .carousel-outer-wrapper {
      padding: 0 2.5rem;
    }

    .carousel-nav-btn {
      width: 36px;
      height: 36px;
    }

    .carousel-nav-btn svg {
      width: 16px;
      height: 16px;
    }

    .testimonial-swiper,
    .testimonial-card {
      min-height: 330px;
      padding: 1.5rem 1.25rem;
    }

    .quote-accent-mark {
      font-size: 3.5rem;
      top: 0.5rem;
      right: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .carousel-outer-wrapper {
      padding: 0 2.2rem;
    }

    .carousel-nav-btn {
      width: 32px;
      height: 32px;
    }

    .carousel-nav-btn svg {
      width: 14px;
      height: 14px;
    }

    .testimonial-swiper,
    .testimonial-card {
      min-height: 380px;
      padding: 1.25rem 1rem;
    }
  }

  @media (max-width: 360px) {
    .carousel-outer-wrapper {
      padding: 0 1.85rem;
    }

    .carousel-nav-btn {
      width: 28px;
      height: 28px;
    }

    .carousel-nav-btn svg {
      width: 12px;
      height: 12px;
    }

    .testimonial-swiper,
    .testimonial-card {
      min-height: 400px;
      padding: 1.15rem 0.85rem;
    }

    .testimonial-quote {
      font-size: 0.9375rem;
      line-height: 1.55;
    }
  }
</style>