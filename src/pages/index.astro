---
import BaseLayout from '../layouts/BaseLayout.astro';
import ApproachPillars from '../components/ApproachPillars.astro';
import ServiceCard from '../components/ServiceCard.astro';
import DoctorProfileCard from '../components/DoctorProfileCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
---

<BaseLayout 
  title="Ekansh Homoeopathic Clinic | Rajsamand, Rajasthan"
  description="Ekansh Homoeopathic Clinic in Rajsamand, Rajasthan. Individualised constitutional homeopathic healthcare. Care that begins with listening."
  activeNav="home"
>
  <!-- =========================================================================
       SECTION 2: HERO SECTION (Split Layout)
       Heading: "A More Personal Approach to Your Healthcare Journey."
       ========================================================================= -->
  <section class="hero-section">
    <div class="container hero-container">
      <!-- Left Column: Editorial Narrative & CTAs -->
      <div class="hero-content">
        <div class="hero-eyebrow-wrap">
          <span class="text-eyebrow">Homoeopathic Clinic &bull; Rajsamand</span>
          <span class="badge badge-sage">Accepting In-Clinic & Online Patients</span>
        </div>

        <h1 class="hero-heading">
          A More Personal Approach to Your Healthcare Journey.
        </h1>

        <p class="hero-tagline">
          Care That Begins With Listening.
        </p>

        <p class="hero-lead text-lead">
          At Ekansh Homoeopathic Clinic, we believe enduring healing starts with an unhurried conversation. Through individualised constitutional homeopathic care, we look beyond isolated symptoms to understand your complete health story.
        </p>

        <div class="hero-cta-group">
          <a href="/book-consultation" class="btn btn-primary btn-lg">
            <span>Book a Consultation</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="/approach" class="btn btn-secondary btn-lg">
            <span>Explore Our Approach</span>
          </a>
        </div>

        <div class="hero-trust-bar">
          <div class="trust-pill">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>45–60 Min Deep Intake</span>
          </div>
          <div class="trust-pill">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <span>Safe & Non-Toxic Remedies</span>
          </div>
          <div class="trust-pill">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>Rajsamand Practice</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Editorial Clinic Visual Frame -->
      <div class="hero-visual">
        <div class="visual-card-wrap">
          <div class="hero-image-frame">
            <!-- Natural Clinic Photography Placeholder Visual -->
            <div class="clinic-photo-placeholder">
              <div class="photo-overlay"></div>
              <div class="photo-inner-content">
                <div class="botanical-symbol">
                  <svg viewBox="0 0 48 48" width="48" height="48" fill="none" stroke="currentColor">
                    <circle cx="24" cy="24" r="22" stroke="#FFFFFF" stroke-width="1.5" stroke-dasharray="4 4"/>
                    <path d="M24 38V18" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/>
                    <path d="M24 26C18 24 11 26 8 32C15 33 22 29 24 26Z" fill="#A3B18A" fill-opacity="0.6" stroke="#FFFFFF" stroke-width="1.5"/>
                    <path d="M24 21C30 19 37 21 40 27C33 28 26 24 24 21Z" fill="#B9A77D" fill-opacity="0.6" stroke="#FFFFFF" stroke-width="1.5"/>
                    <circle cx="24" cy="12" r="5" fill="#FFFFFF"/>
                  </svg>
                </div>
                <span class="photo-caption">Natural Clinic Environment &bull; Rajsamand</span>
                <p class="photo-sub">A Serene Sanctuary for Unhurried Consultation</p>
              </div>
            </div>

            <!-- Floating Trust Badge 1: Local Roots -->
            <div class="floating-badge badge-bottom-left">
              <div class="badge-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 21.7C17.3 17 20 13 20 10a8 8 0 1 0-16 0c0 3 2.7 7 8 11.7z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div>
                <strong>Rajsamand, Rajasthan</strong>
                <small>Physical Clinic & Dispensary</small>
              </div>
            </div>

            <!-- Floating Trust Badge 2: Virtual Consult -->
            <div class="floating-badge badge-top-right">
              <div class="badge-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="23 7 16 12 23 17 23 7"></polygon>
                  <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                </svg>
              </div>
              <div>
                <strong>Online Care</strong>
                <small>Video & Tele-Consultation</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 3: ABOUT SECTION
       Heading: "A Clinic Built Around Personal Attention."
       ========================================================================= -->
  <section class="about-section section-padding" id="about-preview">
    <div class="container">
      <div class="about-grid">
        <div class="about-media">
          <div class="about-card-stack">
            <div class="quote-card card-editorial card-beige">
              <span class="quote-mark">“</span>
              <p class="quote-text">
                True medical care does not rush through a ten-minute checklist. It sits with the patient, unpicks the chronological thread of distress, and treats the whole living individual.
              </p>
              <div class="quote-author">
                <strong>Ekansh Clinical Principle</strong>
                <span>Constitutional Care Doctrine</span>
              </div>
            </div>

            <div class="about-stat-strip">
              <div class="stat-box">
                <span class="stat-num">1-on-1</span>
                <span class="stat-lbl">Individualized Attention</span>
              </div>
              <div class="stat-box">
                <span class="stat-num">60 Min</span>
                <span class="stat-lbl">Initial Constitutional Intake</span>
              </div>
              <div class="stat-box">
                <span class="stat-num">100%</span>
                <span class="stat-lbl">Non-Invasive Therapeutics</span>
              </div>
            </div>
          </div>
        </div>

        <div class="about-text-content">
          <span class="text-eyebrow">Our Clinical Foundation</span>
          <h2 class="about-heading">A Clinic Built Around Personal Attention.</h2>
          
          <p class="about-p text-lead">
            In modern healthcare, patients too often feel processed rather than heard. Ekansh Homoeopathic Clinic was established in Rajsamand to restore genuine human connection to the medical encounter.
          </p>

          <p class="about-p">
            Operated by a dedicated individual homeopathic practitioner, our practice is designed from the ground up for depth. We do not maintain crowded waiting lines or hurried fifteen-minute rotations. Each patient is allocated deliberate, unhurried consultation time to examine the constitutional totality: physical complaints, environmental aggravations, emotional stress patterns, and family medical history.
          </p>

          <p class="about-p">
            Whether you are managing a stubborn chronic allergy, recurrent digestive difficulties, pediatric sensitivities, or seeking restorative balance, our clinic offers a calm, dignified environment dedicated to your long-term vitality.
          </p>

          <div class="about-bullets">
            <div class="bullet-item">
              <div class="b-icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div>
                <strong>Solo Practitioner Accountability:</strong> Direct personal continuity with your doctor throughout your treatment journey.
              </div>
            </div>

            <div class="bullet-item">
              <div class="b-icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div>
                <strong>Root-Cause Constitutional Focus:</strong> Addressing underlying susceptibility rather than masking transient symptoms.
              </div>
            </div>

            <div class="bullet-item">
              <div class="b-icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div>
                <strong>Dual Modality Accessibility:</strong> In-person visits at our Rajsamand clinic alongside structured tele-consultations.
              </div>
            </div>
          </div>

          <div class="about-action">
            <a href="/about" class="btn btn-secondary">
              Read Doctor's Profile & Background
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 4: OUR APPROACH
       Four Pillars: Understanding Your Concerns, Individual Consultation,
       Guidance and Follow-up
       ========================================================================= -->
  <section class="approach-section section-padding" id="approach-preview">
    <div class="container">
      <div class="section-header text-center">
        <span class="text-eyebrow">The Clinical Method</span>
        <h2>Our Consultation Methodology</h2>
        <p class="text-lead">
          Classical homeopathy follows a rigorous, four-stage protocol engineered to understand your unique constitutional state and facilitate lasting vitality.
        </p>
      </div>

      <ApproachPillars />

      <div class="approach-footer-cta text-center">
        <a href="/approach" class="btn btn-secondary btn-sm">
          Detailed Explanation of Case-Taking & Remedies
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 5: SERVICES SECTION
       Four Services: In-Clinic Consultation, Online Consultation,
       Follow-up Consultation and Patient Guidance
       ========================================================================= -->
  <section class="services-section section-padding" id="services-preview">
    <div class="container">
      <div class="section-header text-center">
        <span class="text-eyebrow">Patient Care Options</span>
        <h2>Consultation Services</h2>
        <p class="text-lead">
          Transparent, structured consultation offerings tailored to meet local patients in Rajsamand and outstation patients nationwide.
        </p>
      </div>

      <div class="services-grid">
        <!-- Service 1: In-Clinic -->
        <ServiceCard 
          title="In-Clinic Initial Consultation"
          badge="Rajsamand Practice"
          duration="45 – 60 Minutes"
          description="A comprehensive, face-to-face constitutional intake session at our physical clinic in Rajsamand. Designed for new patients with chronic or recurring complaints."
          features={[
            "Detailed physical, emotional & medical history taking",
            "Individual constitutional repertorisation",
            "Dispensation of certified quality remedies",
            "Personalized dietetic & lifestyle counseling"
          ]}
          feePlaceholder="₹ [Verified On Request]"
          isPopular={true}
          ctaText="Book Clinic Visit"
          ctaHref="/book-consultation?mode=in-clinic"
        />

        <!-- Service 2: Online Tele-Consultation -->
        <ServiceCard 
          title="Online Tele-Consultation"
          badge="Nationwide Video / Audio"
          duration="45 – 60 Minutes"
          description="High-definition virtual consultation for patients across India and abroad who cannot visit Rajsamand in person. Conducted via secure video or phone."
          features={[
            "Confidential digital case-taking protocol",
            "Ayush Telemedicine Guidelines compliant",
            "Secure electronic case notes & prescription",
            "Remedies couriered safely to your doorstep"
          ]}
          feePlaceholder="₹ [Verified On Request]"
          isPopular={false}
          ctaText="Book Online Consult"
          ctaHref="/book-consultation?mode=online"
        />

        <!-- Service 3: Follow-up Consultation -->
        <ServiceCard 
          title="Follow-Up Case Review"
          badge="In-Clinic or Online"
          duration="15 – 20 Minutes"
          description="Structured follow-up session scheduled 3 to 4 weeks post-initial consultation to track healing trajectory, assess remedy action, and adjust potencies."
          features={[
            "Systematic review of symptom progression",
            "Observation according to Hering's Law of Cure",
            "Fine-tuning of remedy potency or repetition",
            "Continued lifestyle & preventive guidance"
          ]}
          feePlaceholder="₹ [Verified On Request]"
          isPopular={false}
          ctaText="Schedule Follow-up"
          ctaHref="/book-consultation"
        />

        <!-- Service 4: Patient Guidance & Acute Care -->
        <ServiceCard 
          title="Acute Care & Lifestyle Guidance"
          badge="Comprehensive Care"
          duration="20 – 30 Minutes"
          description="Focused consultation for seasonal infections, acute allergic flare-ups, or holistic wellness coaching for ongoing constitutional patients."
          features={[
            "Rapid symptom analysis for acute distress",
            "Gentle remedies to support immune defense",
            "Guidance on seasonal diet and hydration",
            "Advice on medicine storage & antidote precautions"
          ]}
          feePlaceholder="₹ [Verified On Request]"
          isPopular={false}
          ctaText="Request Guidance"
          ctaHref="/book-consultation"
        />
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 6: DOCTOR PROFILE
       With professional photograph placeholder and verified-information placeholders
       ========================================================================= -->
  <section class="doctor-section section-padding" id="doctor-preview">
    <div class="container">
      <div class="section-header text-center">
        <span class="text-eyebrow">Meet Your Physician</span>
        <h2>Dedicated To Your Well-Being</h2>
        <p class="text-lead">
          Personal attention, formal medical training, and a deep ethical commitment to gentle, restorative medicine.
        </p>
      </div>

      <DoctorProfileCard showBio={true} />
    </div>
  </section>

  <!-- =========================================================================
       SECTION 7: WHY CHOOSE EKANSH
       ========================================================================= -->
  <section class="why-choose-section section-padding" id="why-choose">
    <div class="container">
      <div class="section-header text-center">
        <span class="text-eyebrow">The Ekansh Distinction</span>
        <h2>Why Patients Choose Ekansh</h2>
        <p class="text-lead">
          We combine classical clinical rigor with compassionate patient respect. Here is how our practice stands apart:
        </p>
      </div>

      <div class="why-grid">
        <div class="why-card card-editorial">
          <div class="why-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </div>
          <h3 class="why-title">Listening First</h3>
          <p class="why-desc">
            We allocate 45 to 60 minutes for your first consultation. You are never interrupted or reduced to an isolated laboratory report.
          </p>
        </div>

        <div class="why-card card-editorial">
          <div class="why-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 class="why-title">Individualized Prescriptions</h3>
          <p class="why-desc">
            No generic combination pills or mass formulas. Your remedy is selected solely based on your unique totality of symptoms.
          </p>
        </div>

        <div class="why-card card-editorial">
          <div class="why-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <h3 class="why-title">Zero Miracle Cure Claims</h3>
          <p class="why-desc">
            We maintain strict medical ethics. We provide clear, honest prognoses without false promises or unscientific guarantees.
          </p>
        </div>

        <div class="why-card card-editorial">
          <div class="why-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <h3 class="why-title">Continuity of Care</h3>
          <p class="why-desc">
            You always speak with the same doctor. Every follow-up builds systematically upon previous case records and observations.
          </p>
        </div>

        <div class="why-card card-editorial">
          <div class="why-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
            </svg>
          </div>
          <h3 class="why-title">Gentle & Non-Toxic</h3>
          <p class="why-desc">
            Homeopathic micro-doses stimulate the body's natural defenses without toxicity, dependency, or harsh chemical burdens.
          </p>
        </div>

        <div class="why-card card-editorial">
          <div class="why-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <h3 class="why-title">Local & Online Reach</h3>
          <p class="why-desc">
            Rooted in Rajsamand with the technology to serve patients seamlessly across India through secure video consultations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 8: PATIENT TESTIMONIALS
       Clearly identified placeholders with ethical disclaimers
       ========================================================================= -->
  <section class="testimonials-section section-padding" id="testimonials">
    <div class="container">
      <div class="section-header text-center">
        <span class="text-eyebrow">Patient Reflections</span>
        <h2>Experiences That Inspire Our Care</h2>
        <p class="text-lead">
          Illustrative reflections highlighting patient experiences with unhurried homeopathic care.
        </p>
      </div>

      <div class="testimonials-grid">
        <TestimonialCard 
          quote="The doctor spent nearly an hour listening to my allergy history, asking questions about things other doctors never even considered. Within months of starting the constitutional remedy, my seasonal sneezing and eye irritation became remarkably manageable."
          patientName="Mr. R. Sharma"
          patientLocation="Rajsamand, Rajasthan"
          conditionCategory="Chronic Allergic Rhinitis"
          consultationType="In-Clinic Patient"
        />

        <TestimonialCard 
          quote="Living in Bengaluru, I was hesitant about online homeopathy. But the video consultation was just as thorough as being in a clinic. The doctor listened patiently, explained the rationale clearly, and the remedies arrived by courier in 3 days."
          patientName="Ms. S. Mehta"
          patientLocation="Bengaluru (Online Patient)"
          conditionCategory="Stress & Digestive Balance"
          consultationType="Online Tele-Consult"
        />

        <TestimonialCard 
          quote="Finding a doctor who handles young children with so much warmth and gentle care is rare. The doctor took the time to understand my 7-year-old daughter's recurring coughs without rushing to strong antibiotics."
          patientName="Mrs. P. Choudhary"
          patientLocation="Nathdwara / Rajsamand"
          conditionCategory="Pediatric Respiratory Health"
          consultationType="In-Clinic Patient"
        />
      </div>

      <div class="testimonial-stat-banner">
        <div class="banner-box">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <p>
            <strong>Regulatory Disclosure:</strong> The reflections above are illustrative patient archetypes awaiting final written verification upon clinic sign-off. In adherence to Ayush ethics, homeopathic remedies act uniquely upon each patient's vitality and results may vary.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 9: FOREST-GREEN CTA SECTION
       Heading: "We're Here to Listen."
       ========================================================================= -->
  <section class="forest-cta-section" id="cta-banner">
    <div class="container cta-container">
      <div class="cta-inner text-center">
        <span class="cta-eyebrow">Your Health Deserves Thoughtful Attention</span>
        <h2 class="cta-heading">We're Here to Listen.</h2>
        <p class="cta-desc text-lead">
          Take the first step toward enduring constitutional wellness. Whether you reside in Rajsamand or require a virtual consultation from afar, our practice is ready to welcome your story.
        </p>

        <div class="cta-buttons">
          <a href="/book-consultation" class="btn btn-gold btn-lg">
            <span>Book Your Consultation</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="https://wa.me/919876543210?text=Hello%20Ekansh%20Clinic,%20I%20would%20like%20to%20enquire%20about%20a%20consultation." target="_blank" rel="noopener noreferrer" class="btn btn-outline-white btn-lg">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            <span>Message on WhatsApp</span>
          </a>
        </div>

        <div class="cta-reassurance">
          <span>&bull; Confidential Case Taking</span>
          <span>&bull; Prior Appointments Recommended</span>
          <span>&bull; Serving Rajsamand & Nationwide</span>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 10: CONTACT INFORMATION, MAP PLACEHOLDER & LOCATION
       ========================================================================= -->
  <section class="contact-preview-section section-padding" id="location-preview">
    <div class="container">
      <div class="section-header text-center">
        <span class="text-eyebrow">Visit or Connect</span>
        <h2>Clinic Location & Hours</h2>
        <p class="text-lead">
          Easily accessible in Rajsamand with dedicated morning and evening patient consultation hours.
        </p>
      </div>

      <div class="contact-preview-grid">
        <!-- Details Column -->
        <div class="contact-info-card card-editorial">
          <div class="clinic-address-block">
            <div class="icon-circle">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div>
              <h3 class="location-name">Ekansh Homoeopathic Clinic</h3>
              <p class="location-address">
                Near [Landmark Placeholder],<br/>
                Rajsamand, Rajasthan – 313324, India
              </p>
              <span class="status-tag status-pending">Exact Street Address Pending Verification</span>
            </div>
          </div>

          <div class="hours-schedule-block">
            <h4 class="schedule-title">Daily Consultation Schedule</h4>
            <div class="schedule-table">
              <div class="sched-row">
                <span class="day">Monday – Saturday</span>
                <span class="time">Morning: 10:00 AM – 1:00 PM<br/>Evening: 5:00 PM – 8:00 PM</span>
              </div>
              <div class="sched-row">
                <span class="day">Sunday</span>
                <span class="time">By Prior Appointment Only</span>
              </div>
            </div>
          </div>

