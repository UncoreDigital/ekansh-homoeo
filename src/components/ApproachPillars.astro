---
const pillars = [
  {
    step: "01",
    title: "Listen Deeply",
    badge: "45–60 Min Intake",
    description: "Unhurried, attentive conversation exploring physical symptoms, emotional state, and personal health chronology.",
    image: "/images/listen.png"
  },
  {
    step: "02",
    title: "Individualize",
    badge: "Constitutional Totality",
    description: "Careful repertorisation matching your singular symptom totality to a specific, single constitutional homeopathic remedy.",
    image: "/images/individualize.png"
  },
  {
    step: "03",
    title: "Prescribe",
    badge: "Gentle Micro-Dose",
    description: "High-grade certified remedies dispensed in minimum therapeutic doses, paired with simple dietary & lifestyle precautions.",
    image: "/images/prescribe.png"
  },
  {
    step: "04",
    title: "Follow-Up",
    badge: "Sustained Vitality",
    description: "Structured reviews at 3 to 4 weeks to observe constitutional response, fine-tune potencies, and ensure lasting health.",
    image: "/images/follow-up.png"
  }
];
---

<div class="approach-grid">
  {pillars.map((item) => (
    <div class="pillar-card card-editorial">
      <div class="pillar-img-wrap">
        <img src={item.image} alt={item.title} class="pillar-img" loading="lazy" width="320" height="160" />
        <span class="pillar-step-badge">{item.step}</span>
      </div>
      <div class="pillar-content">
        <div class="pillar-header-row">
          <h3 class="pillar-title">{item.title}</h3>
          <span class="badge badge-sage pillar-badge">{item.badge}</span>
        </div>
        <p class="pillar-desc">{item.description}</p>
      </div>
    </div>
  ))}
</div>

<style>
  .approach-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 991px) {
    .approach-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .approach-grid {
      grid-template-columns: 1fr;
    }
  }

  .pillar-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    height: 100%;
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-beige);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .pillar-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }

  .pillar-img-wrap {
    width: 100%;
    height: 155px;
    overflow: hidden;
    position: relative;
    background-color: var(--color-forest-dark);
  }

  .pillar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(106%) saturate(94%);
    transition: transform var(--transition-slow);
  }

  .pillar-card:hover .pillar-img {
    transform: scale(1.05);
  }

  .pillar-step-badge {
    position: absolute;
    top: 10px;
    left: 12px;
    background-color: var(--color-forest);
    color: var(--color-gold-light);
    font-family: var(--font-serif);
    font-size: 0.8125rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-xs);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
  }

  .pillar-content {
    padding: 1.25rem 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .pillar-header-row {
    margin-bottom: 0.5rem;
  }

  .pillar-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-charcoal);
    margin-bottom: 0.35rem;
  }

  .pillar-badge {
    font-size: 0.6875rem;
    display: inline-block;
  }

  .pillar-desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-charcoal-muted);
    margin-bottom: 0;
  }
</style>
