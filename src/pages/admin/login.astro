---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Staff Portal Sign In | Ekansh Homoeopathic Clinic" showLogout={false}>
  <div class="login-wrapper">
    <div class="login-card card-editorial">
      <div class="login-header">
        <div class="login-icon">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <span class="text-eyebrow">Clinic Administration</span>
        <h1 class="login-title">Staff Portal Sign In</h1>
        <p class="login-subtitle">
          Secure private workspace for Ekansh Homoeopathic Clinic practitioner &amp; front-desk team.
        </p>
      </div>

      <!-- Error Alert Box -->
      <div id="loginErrorAlert" class="login-error-alert" style="display: none;" role="alert">
        <div class="error-icon">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </div>
        <span id="loginErrorMessage">Invalid email or password.</span>
      </div>

      <form id="adminLoginForm" novalidate>
        <div class="form-group">
          <label for="adminEmail" class="form-label">Clinic Staff Email <span class="required">*</span></label>
          <input 
            type="email" 
            id="adminEmail" 
            name="email" 
            class="form-control" 
            placeholder="staff@ekanshclinic.com" 
            autocomplete="email" 
            required 
          />
          <span class="form-error" id="emailFormatError">Please enter a valid email address.</span>
        </div>

        <div class="form-group">
          <label for="adminPassword" class="form-label">Password <span class="required">*</span></label>
          <input 
            type="password" 
            id="adminPassword" 
            name="password" 
            class="form-control" 
            placeholder="••••••••••••" 
            autocomplete="current-password" 
            required 
          />
          <span class="form-error" id="passwordFormatError">Please enter your password.</span>
        </div>

        <div class="login-action-row">
          <button type="submit" class="btn btn-primary btn-lg" id="loginSubmitBtn" style="width: 100%;">
            <span id="loginSubmitText">Sign In to Office Desk</span>
            <svg id="loginSubmitIcon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
              <polyline points="10 17 15 12 10 7"></polyline>
              <line x1="15" y1="12" x2="3" y2="12"></line>
            </svg>
          </button>
        </div>
      </form>

      <div class="security-callout">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <div>
          <strong>Authorized Access Only:</strong> Direct registration is disabled. Clinic administrator accounts are provisioned exclusively via Supabase Auth and restricted by server-side email allowlist.
        </div>
      </div>

      <div class="return-home">
        <a href="/">← Return to Public Clinic Website</a>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .login-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: calc(100vh - 180px);
    padding: 1.5rem 0;
  }

  .login-card {
    width: 100%;
    max-width: 480px;
    background-color: #FFFFFF;
    border: 1px solid var(--color-beige, #E9E4D7);
    border-radius: var(--radius-md, 8px);
    padding: clamp(2rem, 4vw, 2.75rem);
    box-shadow: 0 4px 20px rgba(48, 56, 50, 0.08);
  }

  .login-header {
    text-align: center;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--color-beige, #E9E4D7);
    padding-bottom: 1.25rem;
  }

  .login-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background-color: var(--color-sage-subtle, #F0F4EE);
    color: var(--color-forest, #355D48);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0.85rem;
    border: 1.5px solid var(--color-sage, #A3B18A);
  }

  .login-title {
    font-size: 1.6rem;
    color: var(--color-forest, #355D48);
    margin-top: 0.35rem;
    margin-bottom: 0.4rem;
    font-family: var(--font-serif, 'Playfair Display', serif);
  }

  .login-subtitle {
    font-size: 0.84375rem;
    color: var(--color-charcoal-muted, #5A665D);
    line-height: 1.5;
    margin-bottom: 0;
  }

  .login-error-alert {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    background-color: #FDF2F2;
    border: 1px solid #F8B4B4;
    border-radius: var(--radius-sm, 6px);
    color: #9B1C1C;
    font-size: 0.84375rem;
    line-height: 1.45;
    margin-bottom: 1.5rem;
  }

  .login-error-alert .error-icon {
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: #E02424;
  }

  .login-action-row {
    margin-top: 1.75rem;
  }

  .security-callout {
    margin-top: 1.75rem;
    display: flex;
    gap: 0.75rem;
    background-color: var(--color-ivory, #F6F5EF);
    border: 1px solid var(--color-beige, #E9E4D7);
    border-radius: var(--radius-sm, 6px);
    padding: 0.85rem 1rem;
    font-size: 0.78125rem;
    color: var(--color-charcoal-muted, #5A665D);
    line-height: 1.5;
  }

  .security-callout svg {
    color: var(--color-forest, #355D48);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .security-callout strong {
    color: var(--color-forest, #355D48);
  }

  .return-home {
    text-align: center;
    margin-top: 1.5rem;
  }

  .return-home a {
    color: var(--color-forest, #355D48);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    transition: color var(--transition-fast, 150ms ease);
  }

  .return-home a:hover {
    color: var(--color-accent-red, #C35137);
    text-decoration: underline;
  }
</style>

<script>
  async function initLoginPage() {
    const form = document.getElementById('adminLoginForm') as HTMLFormElement | null;
    const errorAlert = document.getElementById('loginErrorAlert');
    const errorMessage = document.getElementById('loginErrorMessage');
    const submitBtn = document.getElementById('loginSubmitBtn') as HTMLButtonElement | null;
    const submitText = document.getElementById('loginSubmitText');

    if (!form) return;

    // Check if user already has an active verified session
    const existingToken = sessionStorage.getItem('admin_token') || localStorage.getItem('admin_token');
    if (existingToken) {
      try {
        const verifyRes = await fetch('/api/admin/auth/verify', {
          headers: {
            Authorization: `Bearer ${existingToken}`,
          },
        });
        if (verifyRes.ok) {
          window.location.href = '/admin/dashboard';
          return;
        }
      } catch (e) {
        // Continue to show login form
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorAlert) errorAlert.style.display = 'none';

      const emailInput = document.getElementById('adminEmail') as HTMLInputElement;
      const passInput = document.getElementById('adminPassword') as HTMLInputElement;

      const email = emailInput.value.trim();
      const password = passInput.value;

      let isValid = true;

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        emailInput.classList.add('is-invalid');
        isValid = false;
      } else {
        emailInput.classList.remove('is-invalid');
      }

      if (!password) {
        passInput.classList.add('is-invalid');
        isValid = false;
      } else {
        passInput.classList.remove('is-invalid');
      }

      if (!isValid) return;

      if (submitBtn) submitBtn.disabled = true;
      if (submitText) submitText.textContent = 'Verifying Credentials...';

      try {
        const response = await fetch('/api/admin/auth/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ email, password }),
        });

        const data = await response.json().catch(() => ({}));

        if (!response.ok || !data.success) {
          const msg = data.error || 'Authentication failed. Please check your credentials.';
          if (errorAlert && errorMessage) {
            errorMessage.textContent = msg;
            errorAlert.style.display = 'flex';
          }
          if (submitBtn) submitBtn.disabled = false;
          if (submitText) submitText.textContent = 'Sign In to Office Desk';
          return;
        }

        // Store access token for API requests
        if (data.token) {
          sessionStorage.setItem('admin_token', data.token);
          localStorage.setItem('admin_token', data.token);
        }

        // Redirect to protected dashboard
        window.location.href = '/admin/dashboard';
      } catch (networkErr) {
        if (errorAlert && errorMessage) {
          errorMessage.textContent = 'Unable to connect to authentication server. Please check your internet connection.';
          errorAlert.style.display = 'flex';
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (submitText) submitText.textContent = 'Sign In to Office Desk';
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initLoginPage);
</script>
