---
interface Props {
  title: string;
  badge: string;
  duration: string;
  description: string;
  features: string[];
  feePlaceholder?: string;
  isPopular?: boolean;
  ctaText?: string;
  ctaHref?: string;
}

const {
  title,
  badge,
  duration,
  description,
  features = [],
  feePlaceholder = "₹ [Verified On Request]",
  isPopular = false,
  ctaText = "Request Consultation",
  ctaHref = "/book-consultation"
} = Astro.props;
---

<div class={`service-card card-editorial ${isPopular ? 'popular-card' : ''}`}>
  {isPopular && (
    <div class="popular-ribbon">
      <span>Most Requested</span>
    </div>
  )}

  <div class="service-header">
    <div class="service-badges">
      <span class="badge badge-sage">{badge}</span>
      <span class="service-duration">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        {duration}
      </span>
    </div>
    <h3 class="service-title">{title}</h3>
    <p class="service-desc">{description}</p>
  </div>

  <div class="service-divider"></div>

  <div class="service-body">
    <p class="feature-label">Session Highlights:</p>
    <ul class="feature-list" role="list">
      {features.map((item) => (
        <li>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="service-footer">
    <div class="fee-block">
      <span class="fee-caption">Consultation Fee</span>
      <span class="fee-amount">{feePlaceholder}</span>
    </div>
    <a href={ctaHref} class={`btn ${isPopular ? 'btn-primary' : 'btn-secondary'} btn-sm`}>
      {ctaText}
    </a>
  </div>
</div>

<style>
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2.25rem 2rem;
    background-color: var(--color-white);
  }

  .popular-card {
    border-color: var(--color-forest);
    box-shadow: 0 12px 36px -4px rgba(53, 93, 72, 0.15);
  }

  .popular-ribbon {
    position: absolute;
    top: -12px;
    right: 24px;
    background-color: var(--color-forest);
    color: var(--color-white);
    font-size: 0.71875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.85rem;
    border-radius: var(--radius-full);
    box-shadow: 0 4px 10px rgba(53, 93, 72, 0.25);
  }

  .service-badges {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .service-duration {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78125rem;
    color: var(--color-charcoal-muted);
    font-weight: 500;
  }

  .service-duration svg {
    color: var(--color-forest);
  }

  .service-title {
    font-size: 1.4rem;
    color: var(--color-charcoal);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .service-desc {
    font-size: 0.90625rem;
    line-height: 1.6;
    color: var(--color-charcoal-muted);
    margin-bottom: 0;
  }

  .service-divider {
    height: 1px;
    background-color: var(--color-beige);
    margin: 1.5rem 0;
  }

  .service-body {
    flex-grow: 1;
    margin-bottom: 1.5rem;
  }

  .feature-label {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-forest);
    margin-bottom: 0.875rem;
  }

  .feature-list {
    list-style: none;
  }

  .feature-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: 0.875rem;
    color: var(--color-charcoal);
    margin-bottom: 0.6rem;
    line-height: 1.5;
  }

  .feature-list svg {
    color: var(--color-forest);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .service-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-beige);
  }

  .fee-block {
    display: flex;
    flex-direction: column;
  }

  .fee-caption {
    font-size: 0.71875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-charcoal-light);
  }

  .fee-amount {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-forest);
  }
</style>
