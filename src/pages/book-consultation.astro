---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConsultationForm from '../components/ConsultationForm.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const bookingFAQs = [
  {
    question: "Does submitting this form confirm my appointment?",
    answer: "No. Submitting this form is a consultation request, not an automatic confirmation. Your preferred date and time slot are subject to clinic schedule availability. Our reception desk will review your intake and contact you directly via phone or WhatsApp to verify and confirm your appointment."
  },
  {
    question: "What documents should I prepare for my first appointment?",
    answer: "Please keep previous laboratory test reports, allopathic or other prescription slips, an outline of past major surgeries or illnesses, and a list of your current symptoms and their timings."
  },
  {
    question: "Can I request a consultation for a child or family member?",
    answer: "Yes. You can enter the patient's name and details in the form. For pediatric patients, a parent or legal guardian should be present during both in-clinic and online intake sessions."
  },
  {
    question: "What if I need to cancel or reschedule my time slot?",
    answer: "Please notify the clinic via WhatsApp (+91 97999 88138) or telephone at least 24 hours prior to your scheduled slot so our desk may accommodate other waiting patients."
  }
];
---

<BaseLayout 
  title="Book a Consultation | Ekansh Homoeopathic Clinic, Rajsamand"
  description="Request an unhurried constitutional homeopathic consultation at Ekansh Homoeopathic Clinic. In-clinic in Rajsamand or online nationwide video consultation."
  activeNav="book"
>
  <!-- Page Header -->
  <section class="page-header-section">
    <div class="container text-center">
      <span class="text-eyebrow">Patient Intake Portal</span>
      <h1 class="page-title">Book a Consultation</h1>
      <p class="page-subtitle text-lead">
        Begin your journey toward enduring constitutional wellness. Choose between an in-person consultation at our Rajsamand clinic or a secure virtual tele-consultation.
      </p>
    </div>
  </section>

  <!-- Main Booking Form Section -->
  <section class="section-padding">
    <div class="container">
      <div class="booking-layout-grid">
        <!-- Main Form Column -->
        <div class="booking-form-area">
          <ConsultationForm />
        </div>

        <!-- Preparation & Clinical Guidelines Sidebar -->
        <aside class="booking-sidebar">
          <div class="sidebar-card card-editorial card-beige">
            <h3 class="sidebar-title">How to Prepare for Your Session</h3>
            <p class="sidebar-lead">
              To make the most of your 45 to 60 minute constitutional case-taking, we recommend keeping the following in mind:
            </p>

            <ul class="prep-list" role="list">
              <li>
                <div class="prep-num">1</div>
                <div>
                  <strong>Chronological Health History:</strong> Note down when your complaints first started and any major life events occurring around that time.
                </div>
              </li>
              <li>
                <div class="prep-num">2</div>
                <div>
                  <strong>Characteristic Sensations:</strong> Consider what relieves or aggravates your distress (heat, cold, fresh air, specific foods, times of day).
                </div>
              </li>
              <li>
                <div class="prep-num">3</div>
                <div>
                  <strong>Current Prescriptions:</strong> Have all existing prescription medicines handy so the doctor can evaluate integrative safety.
                </div>
              </li>
              <li>
                <div class="prep-num">4</div>
                <div>
                  <strong>Quiet Environment (Online):</strong> For virtual video sessions, ensure you are in a quiet, private room with reliable internet.
                </div>
              </li>
            </ul>

            <div class="before-visit-sidebar-link" style="margin: 1.25rem 0 1rem; padding-top: 0.85rem; border-top: 1px dashed var(--color-beige-dark); font-size: 0.8125rem;">
              <a href="/#before-visit" style="color: var(--color-forest); font-weight: 600; display: inline-flex; align-items: center; gap: 0.35rem;">
                <span>Detailed "Before Your Visit" preparation guide</span>
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </a>
            </div>

            <div class="direct-booking-box">
              <span class="direct-title">Prefer Direct Telephone Booking?</span>
              <p class="direct-desc">
                If you prefer speaking directly with our clinic desk to check immediate walk-in availability in Rajsamand:
              </p>
              <div class="direct-btns">
                <a href="tel:+919799988138" class="btn btn-secondary btn-sm" style="width: 100%;">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                  Call +91 97999 88138
                </a>
                <a href="https://wa.me/919799988138?text=Hello%20Ekansh%20Clinic,%20I%20would%20like%20to%20book%20an%20appointment." target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-sm" style="width: 100%;">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                  </svg>
                  Chat on WhatsApp
                </a>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Emergency Medical Disclaimer -->
  <section class="section-padding-sm" style="padding-top: 0;">
    <div class="container">
      <div class="medical-disclaimer-card text-center" style="max-width: 900px; margin: 0 auto;">
        <strong>Non-Emergency Clinical Protocol:</strong> Ekansh Homoeopathic Clinic provides planned constitutional and outpatient care. We do not provide acute trauma, surgical, or ICU emergency services. In the event of severe chest pain, breathing collapse, loss of consciousness, or profuse hemorrhaging, please call emergency ambulance services (108/112) or reach your nearest tertiary hospital casualty ward without delay.
      </div>
    </div>
  </section>

  <!-- Booking FAQs -->
  <section class="section-padding faq-section" style="background-color: var(--color-white);">
    <div class="container">
      <div class="section-header text-center">
        <span class="text-eyebrow">Booking Queries</span>
        <h2>Appointment & Scheduling FAQs</h2>
      </div>

      <FAQAccordion items={bookingFAQs} />

      <div class="text-center" style="margin-top: 2rem;">
        <a href="/faqs" class="btn btn-secondary btn-md">
          <span>Have more questions? View All FAQs</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header-section {
    padding: clamp(3rem, 6vw, 5rem) 0 2rem;
    background: radial-gradient(circle at top center, rgba(163, 177, 138, 0.18), transparent 70%);
    border-bottom: 1px solid var(--color-beige);
  }

  .page-title {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    color: var(--color-forest);
  }

  .page-subtitle {
    max-width: 680px;
    margin: 0 auto;
  }

  .booking-layout-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 991px) {
    .booking-layout-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 600px) {
    .sidebar-card {
      padding: 1.35rem 1.15rem;
    }
  }

  .sidebar-card {
    padding: 2.25rem 2rem;
    position: sticky;
    top: 96px;
  }

  .sidebar-title {
    font-size: 1.35rem;
    color: var(--color-forest);
    margin-bottom: 0.5rem;
  }

  .sidebar-lead {
    font-size: 0.875rem;
    color: var(--color-charcoal-muted);
    line-height: 1.55;
    margin-bottom: 1.5rem;
  }

  .prep-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .prep-list li {
    display: flex;
    gap: 0.85rem;
    font-size: 0.84375rem;
    line-height: 1.5;
    color: var(--color-charcoal);
  }

  .prep-num {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: var(--color-forest);
    color: var(--color-white);
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .direct-booking-box {
    background-color: var(--color-white);
    border: 1px solid var(--color-beige-dark);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
  }

  .direct-title {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-forest);
    display: block;
    margin-bottom: 0.35rem;
  }

  .direct-desc {
    font-size: 0.78125rem;
    color: var(--color-charcoal-muted);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .direct-btns {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
</style>
