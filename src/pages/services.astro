---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const servicesFAQs = [
  {
    question: "What does the initial consultation cover?",
    answer: "The initial consultation covers your complete 45 to 60 minute in-depth constitutional intake, medical repertorisation by the physician, individualized remedy selection, and nutritional and lifestyle guidance."
  },
  {
    question: "How do online consultations work without courier delivery?",
    answer: "Online video/audio tele-consultations focus on thorough constitutional case-taking and clinical diagnosis. Following the session, the doctor issues a digital prescription with guidance on medicine names, potencies, and dosage for procurement from licensed homeopathic pharmacies."
  },
  {
    question: "How often are follow-up sessions scheduled?",
    answer: "For chronic conditions, follow-up consultations are typically scheduled every 3 to 4 weeks to evaluate constitutional response, track symptom progression, and adjust remedy potencies."
  },
  {
    question: "Can I switch between online and in-clinic visits?",
    answer: "Yes. Patients may start with an in-clinic consultation at our Rajsamand clinic and continue subsequent follow-ups online, or vice versa, with complete continuity under the same physician."
  }
];
---

<BaseLayout 
  title="Consultation Services | Ekansh Homoeopathic Clinic, Rajsamand"
  description="In-clinic and online constitutional homeopathic consultation services in Rajsamand. Unhurried case-taking, follow-up care, and patient-first medical continuity."
  activeNav="services"
>
  <!-- Header -->
  <section class="page-header-section">
    <div class="container text-center">
      <span class="text-eyebrow">Patient Care Options</span>
      <h1 class="page-title">Consultation Services</h1>
      <p class="page-subtitle text-lead">
        Personalized clinical pathways for patients visiting our Rajsamand clinic or connecting online across India.
      </p>
    </div>
  </section>

  <!-- Services Grid Section -->
  <section class="section-padding">
    <div class="container">
      <div class="services-full-grid">
        <ServiceCard 
          title="In-Clinic Initial Consultation"
          badge="Rajsamand Practice"
          duration="45 – 60 Minutes"
          description="Face-to-face constitutional intake session at our quiet clinic in Rajsamand for new patients."
          image="/images/inClinic.png"
          imageAlt="Ekansh In-Clinic Consultation Room in Rajsamand"
          features={[
            "Detailed 45-60 min physical, mental & health intake",
            "Individual constitutional repertorisation",
            "Certified quality remedies dispensed on-site",
            "Customized dietary and lifestyle guidance"
          ]}
          feePlaceholder="Verified on Request"
          isPopular={true}
          ctaText="Book Clinic Visit"
          ctaHref="/book-consultation?mode=in-clinic"
        />

        <ServiceCard 
          title="Online Tele-Consultation"
          badge="Nationwide Video / Call"
          duration="45 – 60 Minutes"
          description="Digital consultation via secure video or voice call for outstation patients across India and abroad."
          image="/images/online.png"
          imageAlt="Ekansh Online Tele-Consultation Desk"
          features={[
            "Full 45-60 min clinical depth via video call",
            "Ayush Telemedicine Guidelines compliant",
            "Digital prescription & pharmacy guidance",
            "Direct WhatsApp follow-up communication"
          ]}
          feePlaceholder="Verified on Request"
          isPopular={false}
          ctaText="Book Online Consult"
          ctaHref="/book-consultation?mode=online"
        />

        <ServiceCard 
          title="Follow-Up Case Review"
          badge="In-Clinic or Online"
          duration="15 – 20 Minutes"
          description="Scheduled 3 to 4 weeks post-remedy to track healing trajectory and refine potencies."
          image="/images/followup.png"
          imageAlt="Doctor Follow-up Case Register"
          features={[
            "Systematic review of symptom improvements",
            "Observation according to Hering's Law of Cure",
            "Potency adjustment and remedy repetition",
            "Follow-up remedy evaluation & guidance"
          ]}
          feePlaceholder="Verified on Request"
          isPopular={false}
          ctaText="Schedule Follow-Up"
          ctaHref="/book-consultation"
        />

        <ServiceCard 
          title="Acute Illness & Seasonal Care"
          badge="Established Patients"
          duration="20 – 30 Minutes"
          description="Focused consultation for sudden seasonal flu, viral coughs, or acute allergic bouts."
          image="/images/acute.png"
          imageAlt="Homeopathic Acute Care Medicine"
          features={[
            "Targeted analysis of acute symptom triggers",
            "Gentle remedies to support immune defense",
            "Hydration and home care recommendations",
            "Integration with ongoing constitutional treatment"
          ]}
          feePlaceholder="Verified on Request"
          isPopular={false}
          ctaText="Request Acute Care"
          ctaHref="/book-consultation"
        />
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="section-padding-sm faq-section" style="background-color: var(--color-white);">
    <div class="container">
      <div class="section-header text-center" style="margin-bottom: 2rem;">
        <span class="text-eyebrow">Frequently Asked</span>
        <h2>Services &amp; Consultation FAQs</h2>
        <p class="text-muted" style="max-width: 560px; margin: 0 auto;">
          Common questions regarding our in-clinic visits, online tele-consultations, and follow-up reviews.
        </p>
      </div>

      <FAQAccordion items={servicesFAQs} />

      <div class="faq-cta text-center" style="margin-top: 2rem;">
        <a href="/faqs" class="btn btn-secondary btn-md">
          <span>Have more questions? View All FAQs</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header-section {
    padding: clamp(2.5rem, 5vw, 4rem) 0 1.75rem;
    background: radial-gradient(circle at top center, rgba(163, 177, 138, 0.16), transparent 70%);
    border-bottom: 1px solid var(--color-beige);
  }

  .page-title {
    margin-top: 0.4rem;
    margin-bottom: 0.75rem;
    color: var(--color-forest);
  }

  .page-subtitle {
    max-width: 600px;
    margin: 0 auto;
  }

  .services-full-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 860px) {
    .services-full-grid {
      grid-template-columns: 1fr;
    }
  }

  .faq-cta {
    margin-top: 2rem;
  }
</style>
